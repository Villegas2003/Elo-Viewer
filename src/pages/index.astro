// ═══════════════ TEAM STANDINGS ═══════════════
function computeTeamStandings(t) {
  if (!t || t.kind !== 'teams') return null;
  // Recolectar TODAS las partidas únicas (desde la perspectiva del blanco)
  var allGames = [];
  Object.keys(t.games).forEach(function(rankStr){
    var rank = +rankStr;
    (t.games[rank] || []).forEach(function(g){
      if (g.c === 'w') allGames.push({w: rank, b: g.o, res: g.r});
    });
  });

  // Agrupar por par único de equipos (en Suizo cada par juega máx 1 vez por torneo).
  // Cada team match = suma de board results entre esos dos equipos.
  var matchMap = {};
  allGames.forEach(function(g){
    var pW = t.players[g.w] || t.players[String(g.w)];
    var pB = t.players[g.b] || t.players[String(g.b)];
    if (!pW || !pB) return;
    var teamW = pW.tm;
    var teamB = pB.tm;
    if (!teamW || !teamB) return;
    if (teamW === teamB) return;
    var pair = [teamW, teamB].sort();
    var key = pair[0] + '|||' + pair[1];
    if (!matchMap[key]) {
      matchMap[key] = {teamA: pair[0], teamB: pair[1], scoreA: 0, scoreB: 0, boards: []};
    }
    var m = matchMap[key];
    var aScore = teamW === m.teamA ? g.res : (1 - g.res);
    var bScore = teamW === m.teamB ? g.res : (1 - g.res);
    m.scoreA += aScore;
    m.scoreB += bScore;
    m.boards.push({w: g.w, b: g.b, res: g.res, wName: pW.n, bName: pB.n, wTeam: teamW, bTeam: teamB});
  });

  // Construir standings
  var st = {};
  Object.values(matchMap).forEach(function(m){
    [m.teamA, m.teamB].forEach(function(tm){
      if (!st[tm]) st[tm] = {team: tm, mp: 0, bp: 0, games: 0, w: 0, d: 0, l: 0};
    });
    var sA = st[m.teamA], sB = st[m.teamB];
    sA.bp += m.scoreA; sB.bp += m.scoreB;
    sA.games++; sB.games++;
    if (m.scoreA > m.scoreB) { sA.mp += 2; sA.w++; sB.l++; }
    else if (m.scoreA < m.scoreB) { sB.mp += 2; sB.w++; sA.l++; }
    else { sA.mp += 1; sB.mp += 1; sA.d++; sB.d++; }
  });

  var standings = Object.values(st).sort(function(a,b){
    if (b.mp !== a.mp) return b.mp - a.mp;
    return b.bp - a.bp;
  });
  var matches = Object.values(matchMap).sort(function(a,b){
    // Ordenar por equipo con más tableros (más relevante) y luego alfabético
    if (b.boards.length !== a.boards.length) return b.boards.length - a.boards.length;
    return a.teamA.localeCompare(b.teamA);
  });
  return {standings: standings, matches: matches};
}

function renderTeamSection(td) {
  if (!td || !td.standings.length) return '';
  var standingsRows = td.standings.map(function(s, idx){
    var resStr = s.w + 'W · ' + s.d + 'D · ' + s.l + 'L';
    var badgeCls = idx === 0 ? 'badge-pos' : (idx < 3 ? 'badge-cat' : 'badge-info');
    var teamLower = (s.team || '').toLowerCase();
    return '<tr class="team-row" data-team="'+escapeHtml(teamLower)+'">'
      +'<td><span class="badge '+badgeCls+'">'+(idx+1)+'</span></td>'
      +'<td><strong>'+escapeHtml(s.team)+'</strong></td>'
      +'<td class="r">'+s.mp+'</td>'
      +'<td class="r">'+s.bp.toFixed(1)+'</td>'
      +'<td class="c">'+s.games+'</td>'
      +'<td class="c" style="color:var(--text-muted);font-size:12px">'+resStr+'</td>'
      +'</tr>';
  }).join('');

  // Matches uno a uno (sin ronda explícita: en Suizo cada par juega máx 1 vez)
  var matchRows = td.matches.map(function(m){
    var winA = m.scoreA > m.scoreB;
    var winB = m.scoreB > m.scoreA;
    var drawn = m.scoreA === m.scoreB;
    var aClass = winA?'pos':drawn?'':'neg';
    var bClass = winB?'pos':drawn?'':'neg';
    var aL = (m.teamA||'').toLowerCase(), bL = (m.teamB||'').toLowerCase();
    return '<tr class="match-row" data-teams="'+escapeHtml(aL + '|' + bL)+'">'
      +'<td class="r"><strong class="'+aClass+'">'+escapeHtml(m.teamA)+'</strong></td>'
      +'<td class="c"><span class="rnd">'+m.scoreA.toFixed(1)+' – '+m.scoreB.toFixed(1)+'</span></td>'
      +'<td><strong class="'+bClass+'">'+escapeHtml(m.teamB)+'</strong></td>'
      +'<td class="c" style="color:var(--text-muted);font-size:11px">'+m.boards.length+' tab.</td>'
      +'</tr>';
  }).join('');

  var searchInputStyle = 'padding:6px 10px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text);min-width:200px;font-size:13px';

  return '<div class="sect-h"><h3>Standings por equipo</h3><span class="cnt">MP · 2 por ganar, 1 por empatar</span></div>'
    +'<div class="tbl-card">'
    +'<div class="tbl-tb" style="gap:12px;flex-wrap:wrap"><h4>Tabla general</h4>'
    +'<input type="search" id="team-search" placeholder="Buscar mi equipo…" aria-label="Buscar equipo" style="'+searchInputStyle+'" />'
    +'<span class="cnt" id="team-count">'+td.standings.length+' equipos</span></div>'
    +'<div class="tbl-sc"><table>'
    +'<thead><tr><th>#</th><th>Equipo</th><th class="r">MP</th><th class="r">BP</th><th class="c">Matches</th><th class="c">W·D·L</th></tr></thead>'
    +'<tbody id="team-tbody">'+standingsRows+'</tbody></table></div></div>'
    +'<div class="sect-h"><h3>Matches equipo vs equipo</h3><span class="cnt">'+td.matches.length+' totales</span></div>'
    +'<div class="tbl-card">'
    +'<div class="tbl-tb" style="gap:12px;flex-wrap:wrap"><h4>Resultados</h4>'
    +'<input type="search" id="match-search" placeholder="Buscar mi equipo en matches…" aria-label="Buscar equipo en matches" style="'+searchInputStyle+'" />'
    +'<span class="cnt" id="match-count">'+td.matches.length+' matches</span></div>'
    +'<div class="tbl-sc"><table>'
    +'<thead><tr><th class="r">Equipo A</th><th class="c">Marcador</th><th>Equipo B</th><th class="c">Tab.</th></tr></thead>'
    +'<tbody id="match-tbody">'+matchRows+'</tbody></table></div></div>';
}

function renderTournament(tid) {
  var t=ST.tournaments.filter(function(x){return x.id===tid;})[0];
  if(!t){document.getElementById('main-content').innerHTML='<div class="empty"><h3>No encontrado</h3></div>';return;}
