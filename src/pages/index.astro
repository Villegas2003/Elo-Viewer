    var av=ch.length?ch.reduce(function(a,b){return a+b;},0)/ch.length:0;
    var fsT=[]; var fsS={};
    Object.keys(t.players).forEach(function(k){var p=t.players[k];if(p&&p.f&&!fsS[p.f]){fsT.push(p.f);fsS[p.f]=1;}});
    return '<div class="t-card" data-tid="'+t.id+'" role="button" tabindex="0">'
      +'<div class="tc-top"><h4>'+escapeHtml(t.name)+'</h4>'
      +'<button class="btn-ds" data-del="'+t.id+'" aria-label="Eliminar torneo">'+trashSvg()+'</button></div>'
      +'<div class="tc-meta">'
      +(t.category?badge('badge-cat',t.category):'')
      +(t.year?badge('badge-info',t.year):'')
      +(t.location?badge('badge-info',t.location):'')
      +'</div>'
      +'<div class="tc-stats">'
      +'<div class="ts"><div class="tsv">'+Object.keys(t.games).length+'</div><div class="tsl">Jugadores</div></div>'
      +'<div class="ts"><div class="tsv">'+fsT.length+'</div><div class="tsl">Países</div></div>'
      +'<div class="ts"><div class="tsv '+(av>=0?'pos':'neg')+'">'+(av>=0?'+':'')+av.toFixed(1)+'</div><div class="tsl">ΔElo</div></div>'
      +'</div></div>';
  }).join('')+'</div>';

  var sorted=all.slice().sort(function(a,b){return b.delta-a.delta;});
  function pr(p){
    return '<tr><td>'+(p.t?'<span class="badge badge-title" style="margin-right:6px">'+escapeHtml(p.t)+'</span>':'')+'<strong>'+escapeHtml(p.n.split(',')[0])+'</strong></td>'
      +'<td class="c">'+badge('badge-fed',p.f)+'</td>'
      +'<td class="c">'+badge('badge-cat',p.tCat||'—')+'</td>'
      +'<td class="r">'+deltaBadge(p.delta)+'</td></tr>';
  }
  h+='<div class="two-col">'
    +'<div class="tbl-card"><div class="tbl-tb"><h4>Top ganancias</h4><span class="cnt">Top 6</span></div>'
    +'<div class="tbl-sc"><table><thead><tr><th>Jugador</th><th class="c">Fed</th><th class="c">Cat</th><th class="r">ΔElo</th></tr></thead>'
    +'<tbody>'+sorted.slice(0,6).map(pr).join('')+'</tbody></table></div></div>'
    +'<div class="tbl-card"><div class="tbl-tb"><h4>Mayores pérdidas</h4><span class="cnt">Top 6</span></div>'
    +'<div class="tbl-sc"><table><thead><tr><th>Jugador</th><th class="c">Fed</th><th class="c">Cat</th><th class="r">ΔElo</th></tr></thead>'
    +'<tbody>'+sorted.slice(-6).reverse().map(pr).join('')+'</tbody></table></div></div>'
    +'</div>';

  el.innerHTML=h;
  el.querySelectorAll('.t-card').forEach(function(c){
    c.addEventListener('click',function(e){
      var del = e.target.closest('[data-del]');
      if(del){e.stopPropagation();delT(del.dataset.del);return;}
      go('tournament',c.dataset.tid);
    });
    c.addEventListener('keydown', function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); go('tournament', c.dataset.tid); }
    });
  });
  addRowListeners();
}

function renderPlayers() {
  var fed=document.getElementById('f-fed').value;
  var cat=document.getElementById('f-cat').value;
  var sort=document.getElementById('f-sort').value;
  var searchEl=document.getElementById('f-search');
  var q=(searchEl?searchEl.value:'').trim().toLowerCase();
  var list=getPlayers();
  if(fed)list=list.filter(function(p){return p.f===fed;});
  if(cat)list=list.filter(function(p){return p.tCat===cat;});
  if(q)list=list.filter(function(p){
    return (p.n||'').toLowerCase().indexOf(q)>=0
      || (p.team||'').toLowerCase().indexOf(q)>=0
      || (p.t||'').toLowerCase().indexOf(q)>=0;
  });
  var sortFn={delta:function(a,b){return b.delta-a.delta;},rating:function(a,b){return b.g-a.g;},pts:function(a,b){return b.pts-a.pts;},name:function(a,b){return a.n.localeCompare(b.n);}};
  list.sort(sortFn[sort]||sortFn.delta);
  var el=document.getElementById('main-content');
  if(!list.length){
    el.innerHTML='<div class="empty"><div class="ei"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div><h3>Sin resultados</h3><p>No hay jugadores que coincidan con los filtros aplicados.</p></div>';
    return;
  }
  var changes=list.map(function(p){return p.delta;});
  var avg=changes.reduce(function(a,b){return a+b;},0)/changes.length;
  el.innerHTML='<div class="stats">'
    +'<div class="stat"><div class="sl">Jugadores</div><div class="sv">'+list.length+'</div></div>'
    +'<div class="stat"><div class="sl">ΔElo Promedio</div><div class="sv '+(avg>=0?'pos':'neg')+'">'+(avg>=0?'+':'')+avg.toFixed(1)+'</div></div>'
