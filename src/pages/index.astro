function onFile(file) {
  if(!file)return;
  var uz=document.getElementById('uz');
  document.getElementById('uz-ic-w').innerHTML='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
  document.getElementById('uz-title').textContent='Procesando…';
  document.getElementById('uz-desc').textContent='Analizando estructura TUNX';
  var reader=new FileReader();
  reader.onload=function(e){
    try{
      var r=parseFile(e.target.result);
      if(!r||!Object.keys(r.games).length){
        uz.className='uz';
        document.getElementById('uz-ic-w').innerHTML='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
        document.getElementById('uz-title').textContent='Archivo no válido';
        document.getElementById('uz-desc').textContent='No se encontraron partidas';
        return;
      }
      pending=r;
      var n=Object.keys(r.games).length;
      var fsArr=[]; var fsS={};
      Object.keys(r.players).forEach(function(k){var p=r.players[k];if(p&&p.f&&!fsS[p.f]){fsArr.push(p.f);fsS[p.f]=1;}});
      uz.className='uz done';
      document.getElementById('uz-ic-w').innerHTML='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      document.getElementById('uz-title').textContent=file.name;
      var teamInfo = r.kind === 'teams' && r.teams ? ' · ' + r.teams.length + ' equipos' : '';
      document.getElementById('uz-desc').textContent=n+' jugadores'+teamInfo+' · '+(fsArr.slice(0,5).join(', ')+(fsArr.length>5?'…':''));
      var nm=document.getElementById('i-name');
      if(!nm.value)nm.value=file.name.replace(/\.(TUNX|TUMX)$/i,'');
      updateSaveBtn();
    }catch(err){
      uz.className='uz';
      document.getElementById('uz-title').textContent='Error: '+err.message;
    }
  };
  reader.readAsArrayBuffer(file);
}

function saveTournament() {
  // Dispatcher: si tab CR, delegamos al flujo CR (fetch + save)
  if (CURRENT_TAB === 'cr') { saveCRTournament(); return; }
  // File upload flow
  if(!pending)return;
  var name = document.getElementById('i-name').value || 'Torneo';
  var t={
    id:gid(),
    name:name,
    category:document.getElementById('i-cat').value||'',
    location:document.getElementById('i-loc').value||'',
    year:document.getElementById('i-year').value||'',
    kFactor:0,
    players:pending.players,
    games:pending.games,
    kind: pending.kind || 'individual',
    teams: pending.teams || [],
    source: 'file'
  };
  ST.tournaments.push(t);
  saveST();
  closeModal();
  updateFilters();
  renderSB();
  go('tournament',t.id);
  toast('success', 'Torneo agregado: '+name);
}

function delT(id) {
  var t = ST.tournaments.filter(function(x){return x.id===id;})[0];
  var name = t ? t.name : 'este torneo';
  if(!confirm('¿Eliminar '+name+'?'))return;
  ST.tournaments=ST.tournaments.filter(function(x){return x.id!==id;});
  saveST();
  updateFilters();
  renderSB();
  go('dashboard');
  toast('success', 'Torneo eliminado');
}

function toast(type, msg) {
  var c = document.getElementById('toast-c');
  var el = document.createElement('div');
  el.className = 'toast ' + (type || '');
  var icon = type==='success'
    ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
    : type==='error'
    ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>'
    : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
  el.innerHTML = '<span class="ic" aria-hidden="true">'+icon+'</span><span class="msg">'+escapeHtml(msg)+'</span>';
  c.appendChild(el);
  setTimeout(function(){
    el.classList.add('fade');
    setTimeout(function(){ if(el.parentNode) el.parentNode.removeChild(el); }, 300);
  }, 3000);
}

function applyTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  document.getElementById('theme-sun').style.display = t==='dark' ? 'block' : 'none';
  document.getElementById('theme-moon').style.display = t==='dark' ? 'none' : 'block';
  try { localStorage.setItem(TH_KEY, t); } catch(e){}
  if(CV==='dashboard') renderDashboard();
  else if(CV==='players') renderPlayers();
  else if(CV==='settings') renderSettings();
  else if(CV==='tournament' && CT) renderTournament(CT);
}
function toggleTheme() {
  var cur = document.documentElement.getAttribute('data-theme')||'light';
  applyTheme(cur==='dark' ? 'light' : 'dark');
}

function applySb() {
  var s = 'expanded';
  try { s = localStorage.getItem(SB_KEY) || 'expanded'; } catch(e){}
  document.documentElement.setAttribute('data-sb', s);
}
function toggleSb() {
  var cur = document.documentElement.getAttribute('data-sb')||'expanded';
  var n = cur==='expanded'?'collapsed':'expanded';
  document.documentElement.setAttribute('data-sb', n);
  try { localStorage.setItem(SB_KEY, n); } catch(e){}
}
function openMobileSb(){ document.documentElement.setAttribute('data-mobile-sb','open'); }
function closeMobileSb(){ document.documentElement.removeAttribute('data-mobile-sb'); }

// ═══════════════ MODAL TABS ═══════════════
var CURRENT_TAB = 'cr';
function switchTab(name) {
  CURRENT_TAB = name;
  document.querySelectorAll('.tab-btn').forEach(function(b){
    var on = b.dataset.tab === name;
    b.classList.toggle('active', on);
    b.setAttribute('aria-selected', on ? 'true' : 'false');
  });
  document.querySelectorAll('.tab-pane').forEach(function(p){ p.classList.remove('active'); });
  document.getElementById('tab-' + name).classList.add('active');
  // Save button habilitado depende del tab y su contenido
  updateSaveBtn();
}
function updateSaveBtn() {
  var btn = document.getElementById('btn-save');
  if (CURRENT_TAB === 'cr') {
    if (crPending) {
      btn.disabled = false;
      btn.textContent = 'Guardar torneo';
    } else {
      // Modo búsqueda: habilitar si hay texto en el input
      var url = document.getElementById('cr-url').value.trim();
      btn.disabled = !url;
      btn.textContent = 'Buscar';
    }
  } else {
    btn.disabled = !pending;
    btn.textContent = 'Guardar torneo';
  }
}

// ═══════════════ CHESS-RESULTS FETCH ═══════════════
var crPending = null;  // {data:{}, tnr:'1413614'} cuando hay datos listos para guardar

function extractTnr(input) {
  if (!input) return null;
  var s = String(input).trim();
  // Solo dígitos = ya es el TNR
  if (/^\d+$/.test(s)) return s;
  // Buscar tnrNNNN.aspx o tnr=NNNN
  var m = s.match(/tnr(\d+)/i) || s.match(/[?&]tnr=(\d+)/i);
  return m ? m[1] : null;
}

function showCrStatus(kind, html) {
  var el = document.getElementById('cr-status');
  el.className = 'url-status ' + kind;
  el.innerHTML = html;
}

async function fetchCRTournament(tnr) {
  var res = await fetch('/api/cr/' + tnr + '.json');
  if (!res.ok) {
    var err = 'HTTP ' + res.status;
    try { var j = await res.json(); if (j.error) err = j.error; } catch(e){}
    throw new Error(err);
  }
  return await res.json();
}

async function handleCRFetch() {
  var input = document.getElementById('cr-url').value;
  var tnr = extractTnr(input);
  if (!tnr) {
    showCrStatus('error', '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>URL o número inválido');
    return;
  }
  showCrStatus('loading', '<span class="spinner"></span>Descargando datos desde chess-results.com…');
  try {
    var data = await fetchCRTournament(tnr);
    crPending = { tnr: tnr, data: data };
    var msg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
      + '<div><strong>' + escapeHtml(data.name) + '</strong>'
      + '<div style="font-size:11px;margin-top:2px;opacity:.8">'
      + data.players.length + ' jugadores · ' + data.playedRounds + '/' + data.nRounds + ' rondas jugadas · '
      + (data.rounds || []).reduce(function(s,r){return s + (r.matches||[]).length;},0) + ' matches</div></div>';
    showCrStatus('success', msg);
    // Mostrar input de nombre con el default precargado, editable por el usuario
    var nameWrap = document.getElementById('cr-name-wrap');
    var nameInput = document.getElementById('cr-name');
    if (nameWrap && nameInput) {
      nameInput.value = data.name || '';
      nameInput.placeholder = data.name || 'Nombre del torneo';
      nameWrap.style.display = '';
    }
    updateSaveBtn();
  } catch (e) {
    crPending = null;
    var nameWrap2 = document.getElementById('cr-name-wrap');
    if (nameWrap2) nameWrap2.style.display = 'none';
    showCrStatus('error', '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Error: ' + escapeHtml(String(e.message || e)));
    updateSaveBtn();
  }
}

// Convertir la respuesta del endpoint CR al modelo interno (players, games, teams)
function crToInternal(data) {
  var players = {};
  data.players.forEach(function(p){
    players[p.snr] = {
      n: p.name,
      t: p.title || '',
      f: p.fed || '???',
      g: p.rating || 0,
      tm: p.team || '',
      c: '',           // categoría individual no viene en starting rank de teams
      fideId: p.fide || '',
      board: p.board || 0,
      yob: p.yob || 0  // año de nacimiento (necesario para K factor FIDE)
    };
  });
  // Construir games[rank] = [{o, r, c}] desde los rounds.matches.boards
  var games = {};
  Object.keys(players).forEach(function(k){ games[k] = []; });
  (data.rounds || []).forEach(function(rd){
    (rd.matches || []).forEach(function(m){
      (m.boards || []).forEach(function(b){
        var w = b.white, bl = b.black;
        if (!players[w] || !players[bl]) return;
        // Blanco
        games[w].push({ o: bl, r: b.result, c: 'w', round: rd.round });
        // Negro (resultado invertido)
        games[bl].push({ o: w, r: 1 - b.result, c: 'b', round: rd.round });
      });
    });
  });
  var teamSet = {};
  Object.values(players).forEach(function(p){ if (p.tm) teamSet[p.tm] = 1; });
  var teams = Object.keys(teamSet).sort();
  // Detectar kind: si los matches vienen con flag individual:true, es individual.
  // Sino, si hay 'team' en player records → torneo por equipos.
  var hasIndividualFlag = (data.rounds || []).some(function(rd){
    return (rd.matches || []).some(function(m){ return m.individual; });
  });
  var kind = hasIndividualFlag ? 'individual' : (teams.length > 0 ? 'teams' : 'individual');
  // Si es individual, no propagamos teams al modelo (la columna "Club/City" no es team real)
  if (kind === 'individual') {
    Object.values(players).forEach(function(p){ p.tm = ''; });
    teams = [];
  }
  return { players: players, games: games, teams: teams, kind: kind };
}

async function saveCRTournament() {
  if (!crPending) {
    await handleCRFetch();
    return;
  }
  var d = crPending.data;
  var conv = crToInternal(d);
  // Nombre custom del input (si vacío, fallback al nombre original de chess-results)
  var customName = (document.getElementById('cr-name') || {}).value;
  customName = (customName || '').trim();
  var t = {
    id: gid(),
    name: customName || d.name,
    category: '',
    location: '',
    year: d.year ? String(d.year) : '',
    kFactor: 0,
    players: conv.players,
    games: conv.games,
    kind: conv.kind,
    teams: conv.teams,
    source: 'chess-results',
    crTnr: crPending.tnr,
    lastFetch: Date.now(),
    nRounds: d.nRounds,
    playedRounds: d.playedRounds
  };
  ST.tournaments.push(t);
  saveST();
  closeModal();
  updateFilters();
  renderSB();
  go('tournament', t.id);
  toast('success', 'Torneo agregado: ' + d.name);
}

// Auto-refresh: si pasó >5 min desde última carga, refetch en background
var REFRESH_MS = 5 * 60 * 1000;
async function maybeRefreshCR(tournamentId) {
  var t = ST.tournaments.filter(function(x){return x.id===tournamentId;})[0];
  if (!t || t.source !== 'chess-results' || !t.crTnr) return;
  var age = Date.now() - (t.lastFetch || 0);
  if (age < REFRESH_MS) return;
  try {
    var data = await fetchCRTournament(t.crTnr);
    var conv = crToInternal(data);
    t.players = conv.players;
    t.games = conv.games;
    t.teams = conv.teams;
    t.kind = conv.kind;
    t.nRounds = data.nRounds;
    t.playedRounds = data.playedRounds;
    if (data.year) t.year = String(data.year);
    t.lastFetch = Date.now();
    saveST();
    // Re-render si estamos viendo este torneo
    if (CV === 'tournament' && CT === tournamentId) renderTournament(tournamentId);
    toast('success', 'Datos actualizados desde chess-results');
  } catch (e) {
    // Silencioso, ya tenemos cache
    console.warn('CR auto-refresh failed:', e);
  }
}

async function manualRefreshCR(tournamentId) {
  var t = ST.tournaments.filter(function(x){return x.id===tournamentId;})[0];
  if (!t || t.source !== 'chess-results') return;
  toast('success', 'Refrescando…');
  try {
    var data = await fetchCRTournament(t.crTnr);
    var conv = crToInternal(data);
    t.players = conv.players;
    t.games = conv.games;
    t.teams = conv.teams;
    t.kind = conv.kind;
    t.nRounds = data.nRounds;
    t.playedRounds = data.playedRounds;
    if (data.year) t.year = String(data.year);
    t.lastFetch = Date.now();
    saveST();
    if (CV === 'tournament' && CT === tournamentId) renderTournament(tournamentId);
    toast('success', 'Actualizado');
  } catch (e) {
    toast('error', 'No se pudo refrescar: ' + (e.message || e));
  }
}

document.addEventListener('DOMContentLoaded', function() {
  loadST();
  loadSettings();
  applySb();
  var initialTheme = document.documentElement.getAttribute('data-theme')||'light';
  document.getElementById('theme-sun').style.display = initialTheme==='dark' ? 'block' : 'none';
  document.getElementById('theme-moon').style.display = initialTheme==='dark' ? 'none' : 'block';

  if(!ST.tournaments.length){
    ST.tournaments.push({id:gid(),name:PRESET.name,category:PRESET.category,location:PRESET.location,year:String(PRESET.year),kFactor:PRESET.kFactor||0,players:PRESET.players,games:PRESET.games});
    saveST();
  }

  document.getElementById('nav-dashboard').addEventListener('click',function(){go('dashboard');});
  document.getElementById('nav-players').addEventListener('click',function(){go('players');});
  document.getElementById('nav-settings').addEventListener('click',function(){go('settings');});
  var sbSearch = document.getElementById('sb-search');
  if (sbSearch) sbSearch.addEventListener('input', renderSB);
  document.getElementById('sb-add').addEventListener('click',openModal);
  document.getElementById('tb-toggle').addEventListener('click', toggleSb);
  document.getElementById('tb-menu').addEventListener('click', openMobileSb);
  document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
  document.getElementById('scrim').addEventListener('click', closeMobileSb);
  document.getElementById('btn-close').addEventListener('click',closeModal);
  document.getElementById('btn-cancel').addEventListener('click',closeModal);
  document.getElementById('btn-save').addEventListener('click',saveTournament);
  document.getElementById('overlay').addEventListener('click',function(e){
    if(e.target===document.getElementById('overlay'))closeModal();
  });
  document.addEventListener('keydown', function(e){
    if(e.key==='Escape' && document.getElementById('overlay').style.display!=='none') closeModal();
    if(e.key==='Escape') closeMobileSb();
  });

  var uz = document.getElementById('uz');
  var fi = document.getElementById('fi');
  uz.addEventListener('click', function(){ fi.click(); });
  uz.addEventListener('keydown', function(e){
    if(e.key==='Enter'||e.key===' '){ e.preventDefault(); fi.click(); }
  });
  uz.addEventListener('dragover',function(e){e.preventDefault();uz.classList.add('drag');});
  uz.addEventListener('dragleave',function(){uz.classList.remove('drag');});
  uz.addEventListener('drop',function(e){e.preventDefault();uz.classList.remove('drag');onFile(e.dataTransfer.files[0]);});
  fi.addEventListener('change',function(e){onFile(e.target.files[0]);});

  document.getElementById('f-fed').addEventListener('change',renderPlayers);
  document.getElementById('f-cat').addEventListener('change',renderPlayers);
  document.getElementById('f-sort').addEventListener('change',renderPlayers);
  var fSearch=document.getElementById('f-search');
  if (fSearch) fSearch.addEventListener('input', renderPlayers);

  // Tabs del modal
  document.querySelectorAll('.tab-btn').forEach(function(b){
    b.addEventListener('click', function(){ switchTab(b.dataset.tab); });
  });
  // Input URL chess-results
  var crInput = document.getElementById('cr-url');
  crInput.addEventListener('input', function(){
    // Reset estado al editar (forzar nuevo fetch)
    crPending = null;
    document.getElementById('cr-status').className = 'url-status';
    document.getElementById('cr-status').innerHTML = '';
    updateSaveBtn();
  });
  crInput.addEventListener('keydown', function(e){
    if (e.key === 'Enter') { e.preventDefault(); handleCRFetch(); }
  });

  updateFilters();
  renderSB();
  // URL hash routing: si hay hash, ir a esa vista; sino dashboard
  var initRoute = parseUrlHash();
  if (initRoute) {
    if (initRoute.v === 'tournament' && !ST.tournaments.some(function(x){return x.id===initRoute.tid;})) {
      go('dashboard');
    } else {
      go(initRoute.v, initRoute.tid);
    }
  } else {
    go('dashboard');
  }
  // Sincronizar back/forward del navegador con la navegación interna
  window.addEventListener('hashchange', function(){
    var r = parseUrlHash();
    if (!r) { go('dashboard', null, { skipUrl: true }); return; }
    if (r.v === 'tournament' && !ST.tournaments.some(function(x){return x.id===r.tid;})) return;
    if (r.v !== CV || (r.v === 'tournament' && r.tid !== CT)) {
      go(r.v, r.tid, { skipUrl: true });
    }
  });
});
</script>

