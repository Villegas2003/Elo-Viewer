function closeModal(){document.getElementById('overlay').style.display='none';}

function dg(e,cls){e.preventDefault();document.getElementById('uz').className='uz '+cls;}
function dp(e){e.preventDefault();dg(e,'');onFile(e.dataTransfer.files[0]);}

function onFile(file) {
  if (!file) return;
  const uz=document.getElementById('uz');
  uz.innerHTML='<div class="uz-icon">⏳</div><h4>Procesando…</h4><p>Analizando estructura TUNX</p>';
  const reader=new FileReader();
  reader.onload=e=>{
    try {
      const r=parseTUNX(e.target.result);
      if (!r||!Object.keys(r.games).length){
        uz.className='uz';
        uz.innerHTML='<div class="uz-icon">❌</div><h4>Archivo no válido</h4><p>No se encontraron partidas</p>';
        return;
      }
      pending=r;
      const n=Object.keys(r.games).length;
      const fs=[...new Set(Object.values(r.players).map(p=>p.f).filter(Boolean))];
      uz.className='uz done';
      uz.innerHTML=`<div class="uz-icon">✅</div><h4>${file.name}</h4><p>${n} jugadores · ${fs.slice(0,5).join(', ')}${fs.length>5?'…':''}</p>`;
      if (!document.getElementById('iName').value) document.getElementById('iName').value=file.name.replace(/\.TUNX$/i,'');
      document.getElementById('btnSave').disabled=false;
    } catch(err) {
      uz.className='uz';
      uz.innerHTML=`<div class="uz-icon">❌</div><h4>Error: ${err.message}</h4>`;
    }
  };
  reader.readAsArrayBuffer(file);
}

function saveTournament() {
  if (!pending) return;
  const t={
    id:genId(),
    name:document.getElementById('iName').value||'Torneo',
    category:document.getElementById('iCat').value||'',
    location:document.getElementById('iLoc').value||'',
    year:document.getElementById('iYear').value||'',
    kFactor:40,
    players:pending.players,
    games:pending.games
  };
  ST.tournaments.push(t);
  saveST();
  closeModal();
  updateFilters();
  renderSidebar();
  go('tournament',t.id);
}

function delT(id) {
  if (!confirm('¿Eliminar este torneo? Los datos se borrarán del almacenamiento local.')) return;
  ST.tournaments=ST.tournaments.filter(t=>t.id!==id);
  saveST();
  updateFilters();
  renderSidebar();
  go('dashboard');
}

// ═══════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════
function init() {
  loadST();
  if (!ST.tournaments.length) {
    const preset = JSON.parse(presetJSON);
    ST.tournaments.push({id:genId(), name:preset.name, category:preset.category, location:preset.location, year:preset.year, kFactor:preset.kFactor, players:preset.players, games:preset.games});
    saveST();
  }
  updateFilters();
  renderSidebar();
  go('dashboard');
}

document.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
