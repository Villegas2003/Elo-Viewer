function renderTournament(tid) {
  var t=ST.tournaments.filter(function(x){return x.id===tid;})[0];
  if(!t){document.getElementById('content').innerHTML='<div class="empty"><h3>No encontrado</h3></div>';return;}
  var all=getPlayers([tid]), el=document.getElementById('content');
  var fedsSeen={}, feds=[];
  all.forEach(function(p){if(p.f&&!fedsSeen[p.f]){feds.push(p.f);fedsSeen[p.f]=1;}});
  feds.sort();
  var changes=all.map(function(p){return p.delta;});
  var avg=changes.length?changes.reduce(function(a,b){return a+b;},0)/changes.length:0;

  el.innerHTML='<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">'
    +(t.category?badge('bc',t.category):'')+(t.year?badge('bz',t.year):'')+(t.location?badge('bz','📍 '+t.location):'')
    +'</div>'
    +'<div class="stats">'
    +'<div class="stat"><div class="sl">Jugadores</div><div class="sv" style="color:var(--primary)">'+all.length+'</div></div>'
    +'<div class="stat"><div class="sl">Países</div><div class="sv" style="color:var(--amber)">'+feds.length+'</div></div>'
    +'<div class="stat"><div class="sl">ΔElo Prom.</div><div class="sv" style="color:'+(avg>=0?'var(--green)':'var(--red)')+'">'+(avg>=0?'+':'')+avg.toFixed(1)+'</div></div>'
    +'<div class="stat"><div class="sl">Rondas</div><div class="sv" style="color:var(--accent)">'+(all[0]?all[0].games.length:'—')+'</div></div>'
    +'</div>'
    +'<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">'
    +'<select id="tf-fed"><option value="">🌍 Todos los países</option>'
    +feds.map(function(f){return '<option value="'+f+'"'+(f==='CRC'?' selected':'')+'>'+f+'</option>';}).join('')
    +'</select>'
    +'<select id="tf-sort"><option value="delta">Mayor ΔElo</option><option value="rating">Mayor Rating</option><option value="pts">Más Puntos</option></select>'
    +'</div>'
    +'<div class="charts"><div class="ch-card"><h4>ΔElo por jugador</h4><div class="ch-wrap"><canvas id="tc1"></canvas></div></div></div>'
    +'<div class="tbl-card"><div class="tbl-tb"><h4>'+t.name+'</h4></div>'
    +'<div class="tbl-sc"><table>'
    +'<thead><tr><th>#</th><th>Jugador</th><th class="c">Fed</th>'
    +'<th class="r">Rating</th><th class="r">ΔElo</th><th class="r">Rating Final</th>'
    +'<th class="c">Pts/Rd</th><th class="c">K</th></tr></thead>'
    +'<tbody id="t-tbody"></tbody></table></div></div>';

  document.getElementById('tf-fed').addEventListener('change',function(){renderTT(tid);});
  document.getElementById('tf-sort').addEventListener('change',function(){renderTT(tid);});
  renderTT(tid);
}

function renderTT(tid) {
  var t=ST.tournaments.filter(function(x){return x.id===tid;})[0];
  if(!t)return;
  var fed=document.getElementById('tf-fed')?document.getElementById('tf-fed').value:'';
  var sort=document.getElementById('tf-sort')?document.getElementById('tf-sort').value:'delta';
  var list=getPlayers([tid]);
  if(fed)list=list.filter(function(p){return p.f===fed;});
  var sortFn={delta:function(a,b){return b.delta-a.delta;},rating:function(a,b){return b.g-a.g;},pts:function(a,b){return b.pts-a.pts;}};
  list.sort(sortFn[sort]||sortFn.delta);
  if(CH.tc1){try{CH.tc1.destroy();}catch(e){}delete CH.tc1;}
  var ctx=document.getElementById('tc1');
  if(ctx&&list.length){
    var d=list.map(function(p){return p.delta;});
    CH.tc1=new Chart(ctx,{type:'bar',data:{labels:list.map(function(p){return p.n.split(',')[0];}),datasets:[{label:'ΔElo',data:d,backgroundColor:d.map(function(v){return v>0?'rgba(22,163,74,.75)':'rgba(220,38,38,.75)';}),borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{grid:{color:'#f1f5f9'}}}}});
  }
  var tb=document.getElementById('t-tbody');
  if(tb){tb.innerHTML=pRows(list,'t'+tid);addRowListeners();}
}

// ══════════════════════════════════════════
// TOGGLE FILAS (partidas)
// ══════════════════════════════════════════
function addRowListeners() {
  document.querySelectorAll('.trow[data-rowid]').forEach(function(tr){
    tr.addEventListener('click', function(){
      var id=tr.dataset.rowid;
      var gr=document.getElementById('gr-'+id);
      var ar=document.getElementById('ar-'+id);
      if(!gr)return;
      var open=gr.classList.toggle('open');
      tr.classList.toggle('open',open);
      if(ar)ar.style.transform=open?'rotate(90deg)':'';
    });
  });
}

