// ═══════════════════════════════════════════
function getPlayers(tIds=null) {
  const list=[];
  const ts = tIds ? ST.tournaments.filter(t=>tIds.includes(t.id)) : ST.tournaments;
  ts.forEach(t => {
    Object.keys(t.games).forEach(rank => {
      const p = t.players[rank]||t.players[String(rank)];
      if (!p) return;
      const gs = t.games[rank];
      if (!gs||!gs.length) return;
      const {delta,cnt} = calcDelta(p.g, gs, t.players, t.kFactor||40);
      const pts = gs.reduce((s,g)=>s+g.r, 0);
      list.push({...p, rank:+rank, games:gs, delta, pts, cnt, K:t.kFactor||40, tId:t.id, tName:t.name, tCat:t.category||'', tPlayers:t.players});
    });
  });
  return list;
}

function gamesDetail(p, allPlayers, K) {
  let ti=0, rn=0, rows='';
  p.games.forEach((g,i) => {
    const opp = allPlayers[g.o]||allPlayers[String(g.o)]||{n:'?',f:'?',g:0,t:''};
    const e = opp.g>0 ? exp(p.g,opp.g) : null;
    const imp = e!==null ? Math.round(K*(g.r-e)*10)/10 : null;
    if (imp!==null){ti+=imp;rn++;}
    const rc=g.r===1?'rw':g.r===0.5?'rd':'rl';
    const rt=g.r===1?'1 – Victoria':g.r===0.5?'½ – Empate':'0 – Derrota';
    const unr=opp.g<=0?'<span style="color:var(--red);font-size:9px"> sin rating</span>':'';
    rows+=`<tr>
      <td class="c"><span class="rnd">${i+1}</span></td>
      <td>${opp.t?`<span class="badge b-title" style="font-size:9px">${opp.t}</span> `:''}<strong>${opp.n}</strong>${unr}</td>
      <td class="c"><span class="badge b-fed" style="font-size:9px">${opp.f}</span></td>
      <td class="c">${opp.g>0?opp.g:'—'}</td>
      <td class="c" style="color:var(--gray)">${g.c==='w'?'□ Blancas':'■ Negras'}</td>
      <td class="c"><span class="${rc}">${rt}</span></td>
      <td class="r">${e!==null?e.toFixed(4):'—'}</td>
      <td class="r"><strong class="${imp!==null?(imp>0?'pos':imp<0?'neg'):''}">
        ${imp!==null?(imp>0?'+':'')+imp.toFixed(1):'—'}</strong></td>
    </tr>`;
  });
  const ts=(ti>0?'+':'')+ti.toFixed(1);
  const tc=ti>0?'var(--green)':ti<0?'var(--red)':'var(--gray)';
  return `
    <div class="g-info"><strong>ΔRating = K × Σ(resultado − expected)</strong>
      = ${K} × (${p.pts} − ${(p.pts-ti/K).toFixed(3)}) = <strong style="color:${tc}">${ts}</strong>
      <span style="color:var(--gray);font-size:10px"> (${rn} partidas calificadas)</span>
    </div>
    <div style="overflow-x:auto"><table class="g-tbl">
      <thead><tr>
        <th class="c">Rd</th><th>Oponente</th><th class="c">Fed</th>
        <th class="c">Rating</th><th class="c">Color</th><th class="c">Resultado</th>
        <th class="r">Expected</th><th class="r">Impacto K×(R−E)</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table></div>
    <div class="g-sum">
      <span>Suma de impactos = ΔRating total del torneo</span>
      <strong style="color:${tc}">Σ = ${ts}</strong>
    </div>`;
}

function playerTableRows(list, prefix='') {
  let html='';
  list.forEach((p,i) => {
    const bc=p.delta>0?'b-pos':p.delta<0?'b-neg':'b-zero';
    const id=`${prefix}${i}`;
    html+=`
      <tr class="trow" id="tr-${id}" onclick="tog('${id}',${i},'${prefix}')">
        <td><span class="arrow" id="ar-${id}">▶</span>${p.rank}</td>
        <td>${p.t?`<span class="badge b-title">${p.t}</span> `:''}<strong>${p.n}</strong></td>
        <td class="c"><span class="badge b-fed">${p.f}</span></td>
        ${prefix===''?`<td class="c"><span class="badge b-cat">${p.tCat||'—'}</span></td>`:''}
        <td class="r">${p.g}</td>
        <td class="r"><span class="badge ${bc}">${p.delta>0?'+':''}${p.delta.toFixed(1)}</span></td>
        <td class="r"><strong>${Math.round(p.g+p.delta)}</strong></td>
        <td class="c">${p.pts}/${p.games.length}</td>
        <td class="c">${p.K}</td>
      </tr>
      <tr class="games-tr" id="gr-${id}">
        <td colspan="${prefix===''?9:8}" class="g-cell">${gamesDetail(p,p.tPlayers,p.K)}</td>
      </tr>`;
  });
  return html;
}

function tog(id) {
  const gr=document.getElementById(`gr-${id}`);
  const tr=document.getElementById(`tr-${id}`);
  const ar=document.getElementById(`ar-${id}`);
  const open=gr.classList.toggle('open');
  tr.classList.toggle('open',open);
  ar.style.transform=open?'rotate(90deg)':'';
}

