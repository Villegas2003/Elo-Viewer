---
import presetData from '../data/preset.json';
const presetString = JSON.stringify(presetData);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chess Elo Manager</title>
  <link rel="icon" href="/favicon.svg" />
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"
  ></script>
  <style>
    :root {
      --bg: #f0f4f8; --card: #fff; --primary: #1a3a52;
      --accent: #2563eb; --green: #16a34a; --red: #dc2626;
      --amber: #d97706; --gray: #64748b; --border: #e2e8f0;
      --sw: 256px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; font-family: 'Segoe UI', system-ui, sans-serif; background: var(--bg); color: #1e293b; font-size: 13px; }
    .app { display: flex; height: 100vh; overflow: hidden; }
    .sb { width: var(--sw); background: var(--primary); color: #fff; display: flex; flex-direction: column; flex-shrink: 0; }
    .main { flex: 1; overflow-y: auto; display: flex; flex-direction: column; min-width: 0; }
    .sb-head { padding: 18px 16px 12px; border-bottom: 1px solid rgba(255,255,255,.1); }
    .sb-head h1 { font-size: 15px; font-weight: 800; }
    .sb-head p { font-size: 10px; opacity: .5; margin-top: 2px; }
    .sb-sec { padding: 11px 16px 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; opacity: .4; }
    .sb-scroll { flex: 1; overflow-y: auto; padding: 4px 8px; }
    .sb-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; cursor: pointer; border: none; background: none; color: #fff; width: 100%; text-align: left; font-family: inherit; font-size: 12px; transition: background .15s; }
    .sb-item:hover { background: rgba(255,255,255,.08); }
    .sb-item.active { background: rgba(255,255,255,.16); }
    .sb-item .ic { font-size: 13px; width: 18px; flex-shrink: 0; }
    .sb-item .inf { flex: 1; min-width: 0; }
    .sb-item .inf .tt { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sb-item .inf .sub { font-size: 10px; opacity: .55; margin-top: 1px; }
    .sb-item .del { opacity: 0; font-size: 11px; color: rgba(255,120,120,.9); padding: 2px 5px; border-radius: 4px; transition: opacity .15s; flex-shrink: 0; }
    .sb-item:hover .del { opacity: 1; }
    .sb-add { margin: 8px; padding: 9px; background: rgba(255,255,255,.08); border: 1.5px dashed rgba(255,255,255,.2); border-radius: 9px; color: rgba(255,255,255,.65); font-size: 12px; cursor: pointer; text-align: center; transition: all .2s; font-family: inherit; width: calc(100% - 16px); }
    .sb-add:hover { background: rgba(255,255,255,.14); color: #fff; border-color: rgba(255,255,255,.35); }
    .sb-foot { padding: 10px 14px; border-top: 1px solid rgba(255,255,255,.08); font-size: 10px; opacity: .35; text-align: center; }
    .topbar { background: var(--card); border-bottom: 1px solid var(--border); padding: 0 18px; display: flex; align-items: center; gap: 10px; height: 50px; flex-shrink: 0; position: sticky; top: 0; z-index: 20; }
    .topbar h2 { font-size: 14px; font-weight: 700; color: var(--primary); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .filters { display: flex; gap: 7px; align-items: center; flex-wrap: wrap; }
    select, input { padding: 6px 9px; border: 1.5px solid var(--border); border-radius: 7px; font-size: 12px; background: #fff; font-family: inherit; outline: none; color: #1e293b; transition: border-color .2s; }
    select:focus, input:focus { border-color: var(--accent); }
    .content { padding: 16px 18px; flex: 1; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; margin-bottom: 14px; }
    .stat { background: var(--card); border-radius: 10px; padding: 12px 14px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    .sl { font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .6px; margin-bottom: 5px; }
    .sv { font-size: 22px; font-weight: 800; line-height: 1; }
    .t-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; margin-bottom: 14px; }
    .t-card { background: var(--card); border-radius: 11px; padding: 14px; border: 1.5px solid var(--border); transition: all .2s; cursor: pointer; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    .t-card:hover { border-color: var(--accent); box-shadow: 0 3px 10px rgba(37,99,235,.12); }
    .tc-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
    .tc-top h4 { font-size: 13px; font-weight: 700; color: var(--primary); flex: 1; margin-right: 8px; line-height: 1.3; }
    .tc-meta { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 9px; }
    .tc-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 5px; }
    .ts { background: var(--bg); border-radius: 6px; padding: 5px; text-align: center; }
    .tsv { font-size: 14px; font-weight: 800; color: var(--primary); }
    .tsl { font-size: 9px; color: var(--gray); text-transform: uppercase; letter-spacing: .3px; }
    .tbl-card { background: var(--card); border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 14px; }
    .tbl-tb { padding: 11px 14px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .tbl-tb h4 { font-size: 12px; font-weight: 700; color: var(--primary); }
    .tbl-tb .cnt { font-size: 11px; color: var(--gray); }
    .tbl-sc { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    thead { background: #f8fafc; }
    th { padding: 9px 11px; font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .4px; border-bottom: 2px solid var(--border); white-space: nowrap; text-align: left; }
    th.r { text-align: right; } th.c { text-align: center; }
    td { padding: 9px 11px; border-bottom: 1px solid #f1f5f9; }
    td.r { text-align: right; } td.c { text-align: center; }
    .trow { cursor: pointer; transition: background .12s; }
    .trow:hover { background: #f8faff; }
    .trow.open { background: #eff6ff; }
    .gtr { display: none; }
    .gtr.open { display: table-row; }
    .gcell { padding: 0 !important; border-left: 3px solid var(--accent); }
    .badge { display: inline-block; padding: 2px 7px; border-radius: 8px; font-size: 10px; font-weight: 700; white-space: nowrap; }
    .bt { background: #dbeafe; color: #1e40af; }
    .bf { background: #ede9fe; color: #5b21b6; }
    .bc { background: #fef9c3; color: #713f12; }
    .bp { background: #dcfce7; color: #166534; }
    .bn { background: #fee2e2; color: #991b1b; }
    .bz { background: #f1f5f9; color: #475569; }
    .pos { color: var(--green); font-weight: 700; }
    .neg { color: var(--red); font-weight: 700; }
    .arrow { display: inline-block; transition: transform .2s; color: var(--accent); font-size: 9px; margin-right: 4px; }
    .gi { background: #eff6ff; padding: 9px 13px; font-size: 11px; color: #1e40af; border-bottom: 1px solid #bfdbfe; line-height: 1.7; }
    .gs { background: #f0fdf4; padding: 7px 13px; border-top: 1px solid #bbf7d0; display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; }
    .gtbl { width: 100%; border-collapse: collapse; font-size: 11px; }
    .gtbl th { background: #f8fafc; padding: 7px 10px; font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; border-bottom: 1px solid var(--border); text-align: left; }
    .gtbl th.r { text-align: right; } .gtbl th.c { text-align: center; }
    .gtbl td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; }
    .gtbl td.r { text-align: right; } .gtbl td.c { text-align: center; }
    .gtbl tr:hover td { background: #f8faff; }
    .rnd { background: var(--accent); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 700; display: inline-block; min-width: 20px; text-align: center; }
    .rw { background: #dcfce7; color: #166534; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 10px; }
    .rd { background: #fef9c3; color: #713f12; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 10px; }
    .rl { background: #fee2e2; color: #991b1b; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 10px; }
    .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 14px; }
    .ch-card { background: var(--card); border-radius: 10px; padding: 15px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    .ch-card h4 { font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 12px; }
    .ch-wrap { position: relative; height: 200px; }
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .modal { background: #fff; border-radius: 14px; width: 100%; max-width: 500px; box-shadow: 0 20px 60px rgba(0,0,0,.25); overflow: hidden; }
    .mh { padding: 16px 18px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .mh h3 { font-size: 14px; font-weight: 700; color: var(--primary); }
    .mc { background: none; border: none; font-size: 18px; cursor: pointer; color: var(--gray); }
    .mb { padding: 18px; }
    .uz { border: 2px dashed var(--accent); border-radius: 10px; padding: 28px 18px; text-align: center; cursor: pointer; transition: all .2s; background: #f8faff; }
    .uz:hover, .uz.drag { border-color: var(--green); background: #f0fdf4; }
    .uz.done { border-color: var(--green); background: #f0fdf4; }
    .uz-ic { font-size: 28px; margin-bottom: 7px; }
    .uz h4 { font-size: 13px; font-weight: 600; color: var(--primary); margin-bottom: 3px; }
    .uz p { font-size: 11px; color: var(--gray); }
    .fg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 13px; }
    .fg label { display: block; font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
    .fg input, .fg select { width: 100%; }
    .mf { padding: 12px 18px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }
    .btn { padding: 7px 15px; border-radius: 7px; font-size: 12px; font-weight: 600; border: none; cursor: pointer; font-family: inherit; transition: all .15s; }
    .btn-p { background: var(--accent); color: #fff; }
    .btn-p:hover { background: #1d4ed8; }
    .btn-p:disabled { background: #93c5fd; cursor: not-allowed; }
    .btn-g { background: transparent; color: var(--gray); border: 1.5px solid var(--border); }
    .btn-g:hover { background: var(--bg); }
    .btn-ds { background: #fee2e2; color: var(--red); border: none; border-radius: 5px; padding: 3px 7px; font-size: 10px; font-weight: 700; cursor: pointer; }
    .btn-ds:hover { background: #fecaca; }
    .empty { text-align: center; padding: 60px 20px; }
    .ei { font-size: 44px; margin-bottom: 10px; }
    .empty h3 { font-size: 15px; color: var(--primary); font-weight: 700; margin-bottom: 6px; }
    .empty p { font-size: 12px; color: var(--gray); max-width: 280px; margin: 0 auto 14px; line-height: 1.6; }
    .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 14px; }
    @media (max-width: 768px) {
      .sb { display: none; }
      .app { flex-direction: column; height: auto; overflow: visible; }
      .main { overflow-y: visible; }
      .mnav { display: flex !important; }
      .stats { grid-template-columns: 1fr 1fr; }
      .fg-grid { grid-template-columns: 1fr; }
      .charts { grid-template-columns: 1fr; }
    }
    .mnav { display: none; background: var(--primary); overflow-x: auto; padding: 6px 8px; gap: 4px; flex-shrink: 0; }
    .mn-btn { background: none; border: none; color: rgba(255,255,255,.65); padding: 7px 13px; border-radius: 7px; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; font-family: inherit; }
    .mn-btn.active { background: rgba(255,255,255,.15); color: #fff; }
  </style>
</head>
<body>

<!-- MODAL -->
<div class="overlay" id="overlay" style="display:none">
  <div class="modal">
    <div class="mh">
      <h3>Agregar torneo</h3>
      <button class="mc" id="btn-close">✕</button>
    </div>
    <div class="mb">
      <div class="uz" id="uz">
        <div class="uz-ic">📂</div>
        <h4>Arrastra tu archivo .TUNX aquí</h4>
        <p>Descargado desde Chess-Results → Swiss-Manager tournament file</p>
        <input type="file" id="fi" accept=".TUNX,.tunx" style="display:none" />
      </div>
      <div class="fg-grid">
        <div class="fg">
          <label>Nombre</label>
          <input type="text" id="i-name" placeholder="Panamericano U17 2026" />
        </div>
        <div class="fg">
          <label>Categoría</label>
          <select id="i-cat">
            <option value="">Sin categoría</option>
            <option value="U7">U7</option><option value="U8">U8</option>
            <option value="U10">U10</option><option value="U12">U12</option>
            <option value="U14">U14</option><option value="U16">U16</option>
            <option value="U17" selected>U17</option><option value="U18">U18</option>
            <option value="U7F">U7 Femenino</option><option value="U8F">U8 Femenino</option>
            <option value="U10F">U10 Femenino</option><option value="U12F">U12 Femenino</option>
            <option value="U14F">U14 Femenino</option><option value="U16F">U16 Femenino</option>
            <option value="U18F">U18 Femenino</option>
            <option value="Open">Abierto</option><option value="F">Femenino</option>
          </select>
        </div>
        <div class="fg">
          <label>Sede</label>
          <input type="text" id="i-loc" placeholder="Sonsonate, El Salvador" />
        </div>
        <div class="fg">
          <label>Año</label>
          <input type="number" id="i-year" value="2026" min="2000" max="2100" />
        </div>
      </div>
    </div>
    <div class="mf">
      <button class="btn btn-g" id="btn-cancel">Cancelar</button>
      <button class="btn btn-p" id="btn-save" disabled>Guardar</button>
    </div>
  </div>
</div>

<!-- APP -->
<div class="app">
  <nav class="sb">
    <div class="sb-head">
      <h1>♟ Chess Elo</h1>
      <p>Gestor multi-torneo para entrenadores</p>
    </div>
    <div class="sb-sec">Vistas</div>
    <div style="padding:0 8px">
      <button class="sb-item active" id="nav-dashboard">
        <span class="ic">🏠</span>
        <div class="inf"><div class="tt">Dashboard</div></div>
      </button>
      <button class="sb-item" id="nav-players">
        <span class="ic">👥</span>
        <div class="inf">
          <div class="tt">Todos los jugadores</div>
          <div class="sub" id="sb-total">0 jugadores</div>
        </div>
      </button>
    </div>
    <div class="sb-sec">Torneos</div>
    <div class="sb-scroll" id="sb-t"></div>
    <button class="sb-add" id="sb-add">＋ Agregar torneo (.TUNX)</button>
    <div class="sb-foot">Chess Elo Manager v2.0</div>
  </nav>

  <div class="mnav">
    <button class="mn-btn active" id="mn-dash">🏠 Dashboard</button>
    <button class="mn-btn" id="mn-players">👥 Jugadores</button>
    <button class="mn-btn" id="mn-add">➕ Torneo</button>
  </div>

  <div class="main">
    <div class="topbar">
      <h2 id="page-title">Dashboard</h2>
      <div class="filters" id="filter-bar" style="display:none">
        <select id="f-fed"><option value="">🌍 Todos los países</option></select>
        <select id="f-cat"><option value="">📚 Todas las categorías</option></select>
        <select id="f-sort">
          <option value="delta">Mayor ΔElo</option>
          <option value="rating">Mayor Rating</option>
          <option value="pts">Más Puntos</option>
          <option value="name">Nombre A-Z</option>
        </select>
      </div>
    </div>
    <div class="content" id="content"></div>
  </div>
</div>

<!--
  IMPORTANTE: define:vars implica is:inline en Astro.
  Las funciones aquí son globales al documento (no module scope).
  NO se usan onclick="..." en el HTML — todo vía addEventListener.
-->
<script define:vars={{ presetString }}>
// ══════════════════════════════════════════
// DATOS DEL TORNEO PRECARGADO (inyectado por Astro build-time)
// ══════════════════════════════════════════
const PRESET = JSON.parse(presetString); // presetString inyectado por Astro como string seguro

// ══════════════════════════════════════════
// PARSER TUNX (Swiss-Manager binary format)
// ══════════════════════════════════════════
var TITLES = ['GM','IM','FM','CM','WGM','WIM','WFM','WCM','AIM'];
var KR = [2261,2225,2202,2180,2176,2163,2155,2111,2096,2085,2078,2072,2059,2044,2028,2024,2023,2011,2009,2003,1984,1982,1957,1942,1926,1904,1865,1859,1837,1827,1819,1804,1797,1795,1782,1763,1743,1730,1705,1685,1684,1683,1654,1654,1646,1585,0,0];

function parseTUNX(buf) {
  var data = new Uint8Array(buf);
  var view = new DataView(buf);
  function u16(p) { return (p+1 < data.length) ? view.getUint16(p, true) : 0; }

  var ps = -1;
  for (var i = data.length-4; i >= 0; i--) {
    if ((data[i]===0xb3||data[i]===0x93) && data[i+1]===0xff && data[i+2]===0x89 && data[i+3]===0x44) { ps = i+8; break; }
  }
  if (ps < 0) return null;

  var N = 0;
  for (var p = ps; p < data.length-5; p++) {
    var a=u16(p), b=u16(p+2), r=u16(p+4);
    if (a>=1&&a<=250&&b>=1&&b<=250&&r>=1&&r<=3&&a!==b) N = Math.max(N, a, b);
  }
  if (!N) return null;

  var games = {};
  for (var k=1; k<=N; k++) games[k]=[];

  for (var rank=1; rank<=N; rank++) {
    var lo=rank&0xff, hi=(rank>>8)&0xff;
    for (var p2=ps; p2<data.length-5; p2++) {
      if (data[p2]!==lo || data[p2+1]!==hi) continue;
      var prev = p2>=2 ? u16(p2-2) : 0;
      var w, bl, rv;
      if (prev>=1 && prev<=N && prev!==rank) { w=prev; bl=rank; rv=u16(p2+2); }
      else { var nx=u16(p2+2); if(nx>=1&&nx<=N&&nx!==rank){w=rank;bl=nx;rv=u16(p2+4);}else continue; }
      if (rv!==1 && rv!==2 && rv!==3) continue;
      var opp = (w===rank) ? bl : w;
      var already = false;
      for (var gi=0; gi<games[rank].length; gi++) { if(games[rank][gi].o===opp){already=true;break;} }
      if (already) continue;
      var sc = rv===2 ? 0.5 : ((w===rank&&rv===1)||(bl===rank&&rv===3)) ? 1 : 0;
      games[rank].push({o:opp, r:sc, c:w===rank?'w':'b'});
    }
  }

  var players = {};
  for (var rank2=1; rank2<=N; rank2++) {
    var rating = KR[rank2-1] || 0;
    var name='', title='', fed='';
    if (rating > 0) {
      var lo3=rating&0xff, hi3=(rating>>8)&0xff;
      for (var p3=8000; p3<data.length-1; p3++) {
        if (data[p3]!==lo3 || data[p3+1]!==hi3) continue;
        var bs=Math.max(0,p3-300), blk=data.slice(bs,p3+60);
        var j=0, strs=[];
        while (j < blk.length-1) {
          if (blk[j]>=65 && blk[j]<=122 && blk[j+1]===0) {
            var s='', kk=j;
            while(kk<blk.length-1&&blk[kk]>=32&&blk[kk]<=126&&blk[kk+1]===0){s+=String.fromCharCode(blk[kk]);kk+=2;}
            if(s.length>=2)strs.push(s);j=kk;
          } else j++;
        }
        for (var si=0; si<strs.length; si++) {
          var ss=strs[si];
          if(ss.length>=4&&ss.indexOf(' ')>=0&&!name)name=ss;
          if(TITLES.indexOf(ss)>=0)title=ss;
          if(ss.length===3&&ss===ss.toUpperCase()&&!fed)fed=ss;
        }
        break;
      }
    }
    players[rank2]={n:name||('Player '+rank2),t:title,f:fed||'???',g:rating};
  }
  return {players:players, games:games};
}

// ══════════════════════════════════════════
// FÓRMULA ELO FIDE: ΔRating = K × Σ(resultado_i − expected_i)
// ══════════════════════════════════════════
function expScore(ra, rb) { return rb>0 ? 1/(1+Math.pow(10,(rb-ra)/400)) : null; }

function calcDelta(rating, games, players, K) {
  K = K || 40;
  var total=0, cnt=0;
  for (var i=0; i<games.length; i++) {
    var g=games[i];
    var opp=players[g.o]||players[String(g.o)];
    var e=opp?expScore(rating,opp.g):null;
    if(e===null)continue;
    total+=K*(g.r-e);cnt++;
  }
  return {delta:Math.round(total*10)/10, cnt:cnt};
}

// ══════════════════════════════════════════
// ESTADO — localStorage (clave v3 para evitar conflictos)
// ══════════════════════════════════════════
var LS_KEY = 'chess_elo_v3';
var ST = {tournaments:[]};

function gid() { return Date.now().toString(36)+Math.random().toString(36).slice(2,5); }

function loadST() {
  try { var s=localStorage.getItem(LS_KEY); if(s)ST=JSON.parse(s); } catch(e){}
  if(!ST.tournaments)ST.tournaments=[];
}
function saveST() { try{localStorage.setItem(LS_KEY,JSON.stringify(ST));}catch(e){} }

// ══════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════
function getPlayers(tIds) {
  var list=[];
  var ts = tIds ? ST.tournaments.filter(function(t){return tIds.indexOf(t.id)>=0;}) : ST.tournaments;
  ts.forEach(function(t) {
    Object.keys(t.games).forEach(function(rank) {
      var p=t.players[rank]||t.players[String(rank)];
      if(!p)return;
      var gs=t.games[rank];
      if(!gs||!gs.length)return;
      var res=calcDelta(p.g,gs,t.players,t.kFactor||40);
      var pts=gs.reduce(function(s,g){return s+g.r;},0);
      list.push({n:p.n,t:p.t,f:p.f,g:p.g,rank:+rank,games:gs,delta:res.delta,pts:pts,cnt:res.cnt,K:t.kFactor||40,tId:t.id,tName:t.name,tCat:t.category||'',tP:t.players});
    });
  });
  return list;
}

function badge(cls,txt){ return '<span class="badge '+cls+'">'+txt+'</span>'; }

function gameDetail(p, allP, K) {
  var ti=0,rn=0,rows='';
  p.games.forEach(function(g,i) {
    var opp=allP[g.o]||allP[String(g.o)]||{n:'?',f:'?',g:0,t:''};
    var e=opp.g>0?expScore(p.g,opp.g):null;
    var imp=e!==null?Math.round(K*(g.r-e)*10)/10:null;
    if(imp!==null){ti+=imp;rn++;}
    var rc=g.r===1?'rw':g.r===0.5?'rd':'rl';
    var rt=g.r===1?'1 – Victoria':g.r===0.5?'½ – Empate':'0 – Derrota';
    var unr=opp.g<=0?'<span style="color:var(--red);font-size:9px"> sin rating</span>':'';
    var ic=imp!==null?(imp>0?'pos':imp<0?'neg'):'';
    rows+='<tr>'
      +'<td class="c"><span class="rnd">'+(i+1)+'</span></td>'
      +'<td>'+(opp.t?'<span class="badge bt" style="font-size:9px">'+opp.t+'</span> ':'')+'<strong>'+opp.n+'</strong>'+unr+'</td>'
      +'<td class="c">'+badge('bf',opp.f)+'</td>'
      +'<td class="c">'+(opp.g>0?opp.g:'—')+'</td>'
      +'<td class="c" style="color:var(--gray)">'+(g.c==='w'?'□ Blancas':'■ Negras')+'</td>'
      +'<td class="c"><span class="'+rc+'">'+rt+'</span></td>'
      +'<td class="r">'+(e!==null?e.toFixed(4):'—')+'</td>'
      +'<td class="r"><strong class="'+ic+'">'+(imp!==null?(imp>0?'+':'')+imp.toFixed(1):'—')+'</strong></td>'
      +'</tr>';
  });
  var ts=(ti>0?'+':'')+ti.toFixed(1);
  var tc=ti>0?'var(--green)':ti<0?'var(--red)':'var(--gray)';
  var tExp=(p.pts-ti/K).toFixed(3);
  return '<div class="gi"><strong>ΔRating = K × Σ(resultado − expected)</strong>'
    +' = '+K+' × ('+p.pts+' − '+tExp+') = <strong style="color:'+tc+'">'+ts+'</strong>'
    +' <span style="color:var(--gray);font-size:10px">('+rn+' partidas calificadas)</span></div>'
    +'<div style="overflow-x:auto"><table class="gtbl">'
    +'<thead><tr><th class="c">Rd</th><th>Oponente</th><th class="c">Fed</th>'
    +'<th class="c">Rating</th><th class="c">Color</th><th class="c">Resultado</th>'
    +'<th class="r">Expected</th><th class="r">Impacto K×(R−E)</th></tr></thead>'
    +'<tbody>'+rows+'</tbody></table></div>'
    +'<div class="gs"><span>Suma de impactos = ΔRating total</span>'
    +'<strong style="color:'+tc+'">Σ = '+ts+'</strong></div>';
}

function pRows(list, pfx) {
  pfx=pfx||'';
  var hasCat=(pfx==='');
  return list.map(function(p,i){
    var id=pfx+i;
    var bc=p.delta>0?'bp':p.delta<0?'bn':'bz';
    var cols=(hasCat?'<td class="c">'+badge('bc',p.tCat||'—')+'</td>':'');
    return '<tr class="trow" data-rowid="'+id+'">'
      +'<td><span class="arrow" id="ar-'+id+'">▶</span>'+p.rank+'</td>'
      +'<td>'+(p.t?'<span class="badge bt">'+p.t+'</span> ':'')+'<strong>'+p.n+'</strong></td>'
      +'<td class="c">'+badge('bf',p.f)+'</td>'
      +cols
      +'<td class="r">'+p.g+'</td>'
      +'<td class="r"><span class="badge '+bc+'">'+(p.delta>0?'+':'')+p.delta.toFixed(1)+'</span></td>'
      +'<td class="r"><strong>'+Math.round(p.g+p.delta)+'</strong></td>'
      +'<td class="c">'+p.pts+'/'+p.games.length+'</td>'
      +'<td class="c">'+p.K+'</td>'
      +'</tr>'
      +'<tr class="gtr" id="gr-'+id+'">'
      +'<td colspan="'+(hasCat?9:8)+'" class="gcell">'+gameDetail(p,p.tP,p.K)+'</td>'
      +'</tr>';
  }).join('');
}

