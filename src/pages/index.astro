function renderSB() {
  var el=document.getElementById('sb-t');
  var all=getPlayers();
  document.getElementById('sb-total').textContent=all.length+' jugadores';
  if(!ST.tournaments.length){
    el.innerHTML='<div class="sb-empty">Sin torneos cargados</div>';
    return;
  }
  var searchEl = document.getElementById('sb-search');
  var q = (searchEl ? searchEl.value : '').trim().toLowerCase();
  var list = ST.tournaments.filter(function(t){
    if (!q) return true;
    return (t.name||'').toLowerCase().indexOf(q) >= 0
      || (t.category||'').toLowerCase().indexOf(q) >= 0
      || String(t.year||'').indexOf(q) >= 0
      || (t.location||'').toLowerCase().indexOf(q) >= 0;
  });
  if (!list.length) {
    el.innerHTML='<div class="sb-empty">Sin coincidencias</div>';
    return;
  }
  el.innerHTML=list.map(function(t){
    var kindBadge = t.kind === 'teams'
      ? '<span class="mini-badge kind-t">Equipos</span>'
      : '<span class="mini-badge kind-i">Individual</span>';
    var catBadge = t.category ? '<span class="mini-badge">'+escapeHtml(t.category)+'</span>' : '';
    var yearBadge = t.year ? '<span class="mini-badge">'+escapeHtml(String(t.year))+'</span>' : '';
    return '<button class="sb-item'+(CV==='tournament'&&CT===t.id?' active':'')+'" id="snav-'+t.id+'" data-tid="'+t.id+'">'
      +'<span class="ic-w" aria-hidden="true">'+trophySvg()+'</span>'
      +'<span class="lbl">'+escapeHtml(t.name)
        +'<span class="lbl-badges">'+kindBadge+catBadge+yearBadge+'</span>'
      +'</span>'
      +'<span class="del" data-del="'+t.id+'" role="button" aria-label="Eliminar torneo">'+trashSvg()+'</span>'
      +'</button>';
  }).join('');
  el.querySelectorAll('.sb-item').forEach(function(btn){
    btn.addEventListener('click', function(e){
      var del = e.target.closest('[data-del]');
      if(del){ e.stopPropagation(); delT(del.dataset.del); return; }
      go('tournament', btn.dataset.tid);
    });
  });
}

function updateFilters() {
  var all=getPlayers();
  var feds=[]; var fedsSeen={};
  all.forEach(function(p){if(p.f&&!fedsSeen[p.f]){feds.push(p.f);fedsSeen[p.f]=1;}});
  feds.sort();
  var cats=[]; var catsSeen={};
  ST.tournaments.forEach(function(t){if(t.category&&!catsSeen[t.category]){cats.push(t.category);catsSeen[t.category]=1;}});
  cats.sort();
  var fs=document.getElementById('f-fed'), pf=fs.value;
  fs.innerHTML='<option value="">Todos los países</option>'+feds.map(function(f){
    return '<option value="'+f+'"'+(f===pf||(pf===''&&f==='CRC')?' selected':'')+'>'+f+'</option>';
  }).join('');
  var cs=document.getElementById('f-cat');
  cs.innerHTML='<option value="">Todas las categorías</option>'+cats.map(function(c){
    return '<option value="'+c+'">'+c+'</option>';
  }).join('');
}

