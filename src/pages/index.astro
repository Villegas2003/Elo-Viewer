function renderPlayers() {
  var fed=document.getElementById('f-fed').value;
  var cat=document.getElementById('f-cat').value;
  var sort=document.getElementById('f-sort').value;
  var list=getPlayers();
  if(fed)list=list.filter(function(p){return p.f===fed;});
  if(cat)list=list.filter(function(p){return p.tCat===cat;});
  var sortFn={
    delta:function(a,b){return b.delta-a.delta;},
    rating:function(a,b){return b.g-a.g;},
    pts:function(a,b){return b.pts-a.pts;},
    name:function(a,b){return a.n.localeCompare(b.n);}
  };
  list.sort(sortFn[sort]||sortFn.delta);
  var el=document.getElementById('content');
  if(!list.length){
    el.innerHTML='<div class="empty"><div class="ei">🔍</div><h3>Sin resultados</h3><p>No hay jugadores que coincidan con los filtros.</p></div>';
    return;
  }
  var changes=list.map(function(p){return p.delta;});
  var avg=changes.reduce(function(a,b){return a+b;},0)/changes.length;
  el.innerHTML='<div class="stats">'
    +'<div class="stat"><div class="sl">Jugadores</div><div class="sv" style="color:var(--primary)">'+list.length+'</div></div>'
    +'<div class="stat"><div class="sl">ΔElo Prom.</div><div class="sv" style="color:'+(avg>=0?'var(--green)':'var(--red)')+'">'+(avg>=0?'+':'')+avg.toFixed(1)+'</div></div>'
    +'<div class="stat"><div class="sl">Mejor ΔElo</div><div class="sv" style="color:var(--green)">+'+Math.max.apply(null,changes).toFixed(1)+'</div></div>'
    +'<div class="stat"><div class="sl">Peor ΔElo</div><div class="sv" style="color:var(--red)">'+Math.min.apply(null,changes).toFixed(1)+'</div></div>'
    +'</div>'
    +'<div class="charts"><div class="ch-card"><h4>Cambio de Elo — K × Σ impactos</h4><div class="ch-wrap"><canvas id="pc1"></canvas></div></div></div>'
    +'<div class="tbl-card"><div class="tbl-tb"><h4>Jugadores</h4><span class="cnt">('+list.length+')</span></div>'
    +'<div class="tbl-sc"><table>'
    +'<thead><tr><th>#</th><th>Jugador</th><th class="c">Fed</th><th class="c">Cat</th>'
    +'<th class="r">Rating</th><th class="r">ΔElo</th><th class="r">Rating Final</th>'
    +'<th class="c">Pts/Rd</th><th class="c">K</th></tr></thead>'
    +'<tbody>'+pRows(list,'p')+'</tbody>'
    +'</table></div></div>';
  var ctx=document.getElementById('pc1');
  if(ctx){
    var top=list.slice(0,16);
    var d=top.map(function(p){return p.delta;});
    CH.pc1=new Chart(ctx,{type:'bar',data:{labels:top.map(function(p){return p.n.split(',')[0];}),datasets:[{label:'ΔElo',data:d,backgroundColor:d.map(function(v){return v>0?'rgba(22,163,74,.75)':'rgba(220,38,38,.75)';}),borderRadius:5}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{grid:{color:'#f1f5f9'}}}}});
  }
  addRowListeners();
}

