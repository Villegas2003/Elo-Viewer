var pending = null;

function openModal() {
  pending=null;
  document.getElementById('fi').value='';
  document.getElementById('i-name').value='';
  document.getElementById('i-loc').value='';
  document.getElementById('i-year').value='2026';
  document.getElementById('btn-save').disabled=true;
  resetUZ();
  document.getElementById('overlay').style.display='flex';
}

function closeModal() { document.getElementById('overlay').style.display='none'; }

function resetUZ() {
  var uz=document.getElementById('uz');
  uz.className='uz';
  uz.innerHTML='<div class="uz-ic">📂</div><h4>Arrastra tu archivo .TUNX aquí</h4>'
    +'<p>Descargado desde Chess-Results → Swiss-Manager tournament file</p>'
    +'<input type="file" id="fi" accept=".TUNX,.tunx" style="display:none"/>';
  document.getElementById('fi').addEventListener('change',function(e){onFile(e.target.files[0]);});
}

function onFile(file) {
  if(!file)return;
  var uz=document.getElementById('uz');
  uz.innerHTML='<div class="uz-ic">⏳</div><h4>Procesando…</h4><p>Analizando estructura TUNX</p>';
  var reader=new FileReader();
  reader.onload=function(e){
    try{
      var r=parseTUNX(e.target.result);
      if(!r||!Object.keys(r.games).length){
        uz.className='uz';
        uz.innerHTML='<div class="uz-ic">❌</div><h4>Archivo no válido</h4><p>No se encontraron partidas</p>';
        return;
      }
      pending=r;
      var n=Object.keys(r.games).length;
      var fsArr=[]; var fsS={};
      Object.keys(r.players).forEach(function(k){var p=r.players[k];if(p&&p.f&&!fsS[p.f]){fsArr.push(p.f);fsS[p.f]=1;}});
      uz.className='uz done';
      uz.innerHTML='<div class="uz-ic">✅</div><h4>'+file.name+'</h4>'
        +'<p>'+n+' jugadores · '+fsArr.slice(0,5).join(', ')+(fsArr.length>5?'…':'')+'</p>';
      var nm=document.getElementById('i-name');
      if(!nm.value)nm.value=file.name.replace(/\.TUNX$/i,'');
      document.getElementById('btn-save').disabled=false;
    }catch(err){
      uz.className='uz';
      uz.innerHTML='<div class="uz-ic">❌</div><h4>Error: '+err.message+'</h4>';
    }
  };
  reader.readAsArrayBuffer(file);
}

function saveTournament() {
  if(!pending)return;
  var t={
    id:gid(),
    name:document.getElementById('i-name').value||'Torneo',
    category:document.getElementById('i-cat').value||'',
    location:document.getElementById('i-loc').value||'',
    year:document.getElementById('i-year').value||'',
    kFactor:40,
    players:pending.players,
    games:pending.games
  };
  ST.tournaments.push(t);
  saveST();
  closeModal();
  updateFilters();
  renderSB();
  go('tournament',t.id);
}

function delT(id) {
  if(!confirm('¿Eliminar este torneo?'))return;
  ST.tournaments=ST.tournaments.filter(function(t){return t.id!==id;});
  saveST();
  updateFilters();
  renderSB();
  go('dashboard');
}

// ══════════════════════════════════════════
// INIT — se ejecuta cuando el DOM está listo
// ══════════════════════════════════════════
document.addEventListener('DOMContentLoaded', function() {
  loadST();

  // Cargar preset si no hay torneos guardados
  if(!ST.tournaments.length){
    ST.tournaments.push({
      id:gid(),
      name:PRESET.name,
      category:PRESET.category,
      location:PRESET.location,
      year:String(PRESET.year),
      kFactor:PRESET.kFactor||40,
      players:PRESET.players,
      games:PRESET.games
    });
    saveST();
  }

  // Registrar event listeners (NO onclick en HTML)
  document.getElementById('nav-dashboard').addEventListener('click',function(){go('dashboard');});
  document.getElementById('nav-players').addEventListener('click',function(){go('players');});
  document.getElementById('sb-add').addEventListener('click',openModal);
  document.getElementById('mn-dash').addEventListener('click',function(){go('dashboard');});
  document.getElementById('mn-players').addEventListener('click',function(){go('players');});
  document.getElementById('mn-add').addEventListener('click',openModal);
  document.getElementById('btn-close').addEventListener('click',closeModal);
  document.getElementById('btn-cancel').addEventListener('click',closeModal);
  document.getElementById('btn-save').addEventListener('click',saveTournament);
  document.getElementById('overlay').addEventListener('click',function(e){if(e.target===document.getElementById('overlay'))closeModal();});
  document.getElementById('uz').addEventListener('click',function(){document.getElementById('fi').click();});
  document.getElementById('uz').addEventListener('dragover',function(e){e.preventDefault();document.getElementById('uz').classList.add('drag');});
  document.getElementById('uz').addEventListener('dragleave',function(){document.getElementById('uz').classList.remove('drag');});
  document.getElementById('uz').addEventListener('drop',function(e){e.preventDefault();document.getElementById('uz').classList.remove('drag');onFile(e.dataTransfer.files[0]);});
  document.getElementById('fi').addEventListener('change',function(e){onFile(e.target.files[0]);});
  document.getElementById('f-fed').addEventListener('change',renderPlayers);
  document.getElementById('f-cat').addEventListener('change',renderPlayers);
  document.getElementById('f-sort').addEventListener('change',renderPlayers);

  updateFilters();
  renderSB();
  go('dashboard');
});
</script>

</body>
</html>
