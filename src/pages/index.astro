  var renameBtn = '<button class="btn btn-g" id="t-rename" style="padding:6px 12px;font-size:12px'
    + (t.source !== 'chess-results' ? ';margin-left:auto' : '') + '" title="Renombrar torneo">'
    + '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>'
    + 'Renombrar</button>';

  el.innerHTML='<div class="page-meta" style="align-items:center">'
    +typeLabel
    +(t.category?badge('badge-cat',t.category):'')+(t.year?badge('badge-info',t.year):'')+(t.location?badge('badge-info',t.location):'')
    +liveBadge
    +renameBtn
    +'</div>'
    +'<div class="stats">'
    +(isTeams?'<div class="stat"><div class="sl">Equipos</div><div class="sv">'+nTeams+'</div></div>':'')
    +'<div class="stat"><div class="sl">Jugadores</div><div class="sv">'+all.length+'</div></div>'
    +'<div class="stat"><div class="sl">Países</div><div class="sv">'+feds.length+'</div></div>'
    +(isTeams?'':'<div class="stat"><div class="sl">ΔElo Promedio</div><div class="sv '+(avg>=0?'pos':'neg')+'">'+(avg>=0?'+':'')+avg.toFixed(1)+'</div></div>')
    +'<div class="stat"><div class="sl">Rondas</div><div class="sv">'+(all[0]?all[0].games.length:'—')+'</div></div>'
    +'</div>'
    +(isTeams && teamData ? renderTeamSection(teamData) : '')
    +'<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;align-items:center">'
    +'<input type="search" id="tf-search" placeholder="Buscar jugador…" aria-label="Buscar jugador" style="padding:6px 10px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text);min-width:200px;flex:1 1 200px;max-width:320px" />'
    +'<select id="tf-fed" aria-label="Filtrar por federación"><option value="">Todos los países</option>'
    +feds.map(function(f){return '<option value="'+f+'"'+(f==='CRC'?' selected':'')+'>'+f+'</option>';}).join('')
    +'</select>'
    +(isTeams && t.teams && t.teams.length ?
      '<select id="tf-team" aria-label="Filtrar por equipo"><option value="">Todos los equipos</option>'
      +t.teams.map(function(tm){return '<option value="'+escapeHtml(tm)+'">'+escapeHtml(tm)+'</option>';}).join('')
      +'</select>'
      : '')
    +'<select id="tf-sort" aria-label="Ordenar por"><option value="delta">Mayor ΔElo</option><option value="rating">Mayor Rating</option><option value="pts">Más Puntos</option></select>'
    +'</div>'
    +'<div class="charts"><div class="ch-card"><h4>ΔElo por jugador</h4><div class="ch-wrap"><canvas id="tc1"></canvas></div></div></div>'
    +'<div class="tbl-card"><div class="tbl-tb"><h4>'+escapeHtml(t.name)+'</h4></div>'
    +'<div class="tbl-sc"><table>'
    +'<thead><tr><th>#</th><th>Jugador</th><th class="c">Fed</th>'
    +(isTeams?'<th>Equipo</th>':'')
    +'<th class="r">Rating</th><th class="r">ΔElo</th><th class="r">Rating Final</th>'
    +'<th class="c">Pts/Rd</th><th class="c">K</th></tr></thead>'
    +'<tbody id="t-tbody"></tbody></table></div></div>';

  document.getElementById('tf-fed').addEventListener('change',function(){renderTT(tid);});
  document.getElementById('tf-sort').addEventListener('change',function(){renderTT(tid);});
  var tfSearch=document.getElementById('tf-search');
