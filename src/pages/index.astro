function renderDashboard() {
  var all=getPlayers(), el=document.getElementById('content');
  var fedsSeen={}, feds=[];
  all.forEach(function(p){if(p.f&&!fedsSeen[p.f]){feds.push(p.f);fedsSeen[p.f]=1;}});
  var changes=all.map(function(p){return p.delta;});
  var avg=changes.length?changes.reduce(function(a,b){return a+b;},0)/changes.length:0;

  var h='<div class="stats">'
    +'<div class="stat"><div class="sl">Torneos</div><div class="sv" style="color:var(--accent)">'+ST.tournaments.length+'</div></div>'
    +'<div class="stat"><div class="sl">Jugadores</div><div class="sv" style="color:var(--primary)">'+all.length+'</div></div>'
    +'<div class="stat"><div class="sl">Países</div><div class="sv" style="color:var(--amber)">'+feds.length+'</div></div>'
    +'<div class="stat"><div class="sl">ΔElo Prom.</div><div class="sv" style="color:'+(avg>=0?'var(--green)':'var(--red)')+'">'+(avg>=0?'+':'')+avg.toFixed(1)+'</div></div>'
    +'</div>';

  if(!ST.tournaments.length){
    el.innerHTML=h+'<div class="empty"><div class="ei">📂</div><h3>Sin torneos cargados</h3>'
      +'<p>Agrega archivos .TUNX desde Chess-Results para analizar los cambios de Elo.</p>'
      +'<button class="btn btn-p" id="empty-add">＋ Agregar primer torneo</button></div>';
    document.getElementById('empty-add').addEventListener('click', openModal);
    return;
  }

  h+='<div class="t-grid">'+ST.tournaments.map(function(t){
    var tp=getPlayers([t.id]);
    var ch=tp.map(function(p){return p.delta;});
    var av=ch.length?ch.reduce(function(a,b){return a+b;},0)/ch.length:0;
    var fsT=[]; var fsS={};
    Object.keys(t.players).forEach(function(k){var p=t.players[k];if(p&&p.f&&!fsS[p.f]){fsT.push(p.f);fsS[p.f]=1;}});
    return '<div class="t-card" data-tid="'+t.id+'">'
      +'<div class="tc-top"><h4>'+t.name+'</h4><button class="btn-ds" data-del="'+t.id+'">🗑</button></div>'
      +'<div class="tc-meta">'
      +(t.category?badge('bc',t.category):'')
      +(t.year?badge('bz',t.year):'')
      +(t.location?badge('bz','📍 '+t.location):'')
      +'</div>'
      +'<div class="tc-stats">'
      +'<div class="ts"><div class="tsv">'+Object.keys(t.games).length+'</div><div class="tsl">Jugadores</div></div>'
      +'<div class="ts"><div class="tsv">'+fsT.length+'</div><div class="tsl">Países</div></div>'
      +'<div class="ts"><div class="tsv" style="color:'+(av>=0?'var(--green)':'var(--red)')+'">'+(av>=0?'+':'')+av.toFixed(1)+'</div><div class="tsl">ΔElo Prom</div></div>'
      +'</div></div>';
  }).join('')+'</div>';

  var sorted=all.slice().sort(function(a,b){return b.delta-a.delta;});
  function pr(p){
    return '<tr><td>'+(p.t?badge('bt',p.t)+' ':'')+(p.n.split(',')[0])+'</td>'
      +'<td class="c">'+badge('bf',p.f)+'</td>'
      +'<td class="c">'+badge('bc',p.tCat||'—')+'</td>'
      +'<td class="r"><span class="badge '+(p.delta>0?'bp':'bn')+'">'+(p.delta>0?'+':'')+p.delta.toFixed(1)+'</span></td></tr>';
  }
  h+='<div class="two-col">'
    +'<div class="tbl-card"><div class="tbl-tb"><h4>🏅 Top ganancias</h4></div>'
    +'<table><thead><tr><th>Jugador</th><th class="c">Fed</th><th class="c">Cat</th><th class="r">ΔElo</th></tr></thead>'
    +'<tbody>'+sorted.slice(0,6).map(pr).join('')+'</tbody></table></div>'
    +'<div class="tbl-card"><div class="tbl-tb"><h4>📉 Mayor pérdida</h4></div>'
    +'<table><thead><tr><th>Jugador</th><th class="c">Fed</th><th class="c">Cat</th><th class="r">ΔElo</th></tr></thead>'
    +'<tbody>'+sorted.slice(-6).reverse().map(pr).join('')+'</tbody></table></div>'
    +'</div>';

  el.innerHTML=h;
  el.querySelectorAll('.t-card').forEach(function(c){
    c.addEventListener('click',function(e){
      if(e.target.dataset.del){e.stopPropagation();delT(e.target.dataset.del);return;}
      go('tournament',c.dataset.tid);
    });
  });
  addRowListeners();
}

