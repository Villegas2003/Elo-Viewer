<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chess Elo Manager</title>
  <link rel="icon" href="/favicon.svg" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg: #f0f4f8;
      --card: #ffffff;
      --primary: #1a3a52;
      --accent: #2563eb;
      --green: #16a34a;
      --red: #dc2626;
      --amber: #d97706;
      --gray: #64748b;
      --border: #e2e8f0;
      --sidebar: 256px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; background: var(--bg); color: #1e293b; font-size: 13px; }

    /* LAYOUT */
    .app { display: flex; height: 100vh; overflow: hidden; }
    .sidebar { width: var(--sidebar); background: var(--primary); color: #fff; display: flex; flex-direction: column; flex-shrink: 0; }
    .main { flex: 1; overflow-y: auto; display: flex; flex-direction: column; min-width: 0; }

    /* SIDEBAR */
    .sb-head { padding: 18px 16px 12px; border-bottom: 1px solid rgba(255,255,255,.1); }
    .sb-head h1 { font-size: 15px; font-weight: 800; }
    .sb-head p { font-size: 10px; opacity: .5; margin-top: 3px; }
    .sb-label { padding: 12px 16px 5px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; opacity: .4; }
    .sb-scroll { flex: 1; overflow-y: auto; padding: 4px 8px; }
    .sb-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; cursor: pointer; border: none; background: none; color: #fff; width: 100%; text-align: left; font-family: inherit; font-size: 12px; transition: background .15s; }
    .sb-item:hover { background: rgba(255,255,255,.08); }
    .sb-item.active { background: rgba(255,255,255,.16); }
    .sb-item .icon { font-size: 13px; width: 18px; flex-shrink: 0; }
    .sb-item .info { flex: 1; min-width: 0; }
    .sb-item .info .title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sb-item .info .sub { font-size: 10px; opacity: .55; margin-top: 1px; }
    .sb-item .del { opacity: 0; font-size: 12px; color: rgba(255,120,120,.9); padding: 2px 5px; border-radius: 4px; transition: opacity .15s; flex-shrink: 0; }
    .sb-item:hover .del { opacity: 1; }
    .sb-item .del:hover { background: rgba(255,80,80,.2); }
    .sb-add { margin: 8px; padding: 9px; background: rgba(255,255,255,.08); border: 1.5px dashed rgba(255,255,255,.2); border-radius: 9px; color: rgba(255,255,255,.65); font-size: 12px; cursor: pointer; text-align: center; transition: all .2s; font-family: inherit; width: calc(100% - 16px); }
    .sb-add:hover { background: rgba(255,255,255,.14); color: #fff; border-color: rgba(255,255,255,.35); }
    .sb-foot { padding: 10px 14px; border-top: 1px solid rgba(255,255,255,.08); font-size: 10px; opacity: .35; text-align: center; }

    /* TOPBAR */
    .topbar { background: var(--card); border-bottom: 1px solid var(--border); padding: 0 18px; display: flex; align-items: center; gap: 10px; height: 50px; flex-shrink: 0; position: sticky; top: 0; z-index: 20; }
    .topbar h2 { font-size: 14px; font-weight: 700; color: var(--primary); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .filters { display: flex; gap: 7px; align-items: center; flex-wrap: wrap; }
    select, input[type=text], input[type=number] { padding: 6px 9px; border: 1.5px solid var(--border); border-radius: 7px; font-size: 12px; background: #fff; font-family: inherit; outline: none; color: #1e293b; transition: border-color .2s; }
    select:focus, input:focus { border-color: var(--accent); }

    /* CONTENT */
    .content { padding: 16px 18px; flex: 1; }

    /* STATS */
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; margin-bottom: 14px; }
    .stat { background: var(--card); border-radius: 10px; padding: 12px 14px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    .stat-lbl { font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .6px; margin-bottom: 5px; }
    .stat-val { font-size: 22px; font-weight: 800; line-height: 1; }

    /* TOURNAMENT GRID */
    .t-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; margin-bottom: 14px; }
    .t-card { background: var(--card); border-radius: 11px; padding: 15px; border: 1.5px solid var(--border); transition: all .2s; cursor: pointer; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    .t-card:hover { border-color: var(--accent); box-shadow: 0 3px 10px rgba(37,99,235,.12); }
    .t-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 9px; }
    .t-card-top h4 { font-size: 13px; font-weight: 700; color: var(--primary); flex: 1; margin-right: 8px; line-height: 1.3; }
    .t-meta { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 10px; }
    .t-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 5px; }
    .t-s { background: var(--bg); border-radius: 6px; padding: 6px; text-align: center; }
    .t-s-val { font-size: 15px; font-weight: 800; color: var(--primary); }
    .t-s-lbl { font-size: 9px; color: var(--gray); text-transform: uppercase; letter-spacing: .3px; }

    /* TABLE */
    .tbl-card { background: var(--card); border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.06); overflow: hidden; }
    .tbl-toolbar { padding: 11px 14px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .tbl-toolbar h4 { font-size: 12px; font-weight: 700; color: var(--primary); }
    .tbl-toolbar .cnt { font-size: 11px; color: var(--gray); }
    .tbl-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    thead { background: #f8fafc; }
    th { padding: 9px 11px; font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .4px; border-bottom: 2px solid var(--border); white-space: nowrap; text-align: left; }
    th.r { text-align: right; } th.c { text-align: center; }
    td { padding: 9px 11px; border-bottom: 1px solid #f1f5f9; }
    td.r { text-align: right; } td.c { text-align: center; }
    .trow { cursor: pointer; transition: background .12s; }
    .trow:hover { background: #f8faff; }
    .trow.open { background: #eff6ff; }
    .games-tr { display: none; }
    .games-tr.open { display: table-row; }
    .g-cell { padding: 0 !important; border-left: 3px solid var(--accent); }

    /* BADGES */
    .badge { display: inline-block; padding: 2px 7px; border-radius: 8px; font-size: 10px; font-weight: 700; white-space: nowrap; }
    .b-title { background: #dbeafe; color: #1e40af; }
    .b-fed { background: #ede9fe; color: #5b21b6; }
    .b-cat { background: #fef9c3; color: #713f12; }
    .b-pos { background: #dcfce7; color: #166534; }
    .b-neg { background: #fee2e2; color: #991b1b; }
    .b-zero { background: #f1f5f9; color: #475569; }
    .pos { color: var(--green); font-weight: 700; }
    .neg { color: var(--red); font-weight: 700; }
    .arrow { display: inline-block; transition: transform .2s; color: var(--accent); font-size: 9px; margin-right: 4px; }

    /* GAMES DETAIL */
    .g-info { background: #eff6ff; padding: 9px 13px; font-size: 11px; color: #1e40af; border-bottom: 1px solid #bfdbfe; line-height: 1.7; }
    .g-sum { background: #f0fdf4; padding: 7px 13px; border-top: 1px solid #bbf7d0; display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; }
    .g-tbl { width: 100%; border-collapse: collapse; font-size: 11px; }
    .g-tbl th { background: #f8fafc; padding: 7px 10px; font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; border-bottom: 1px solid var(--border); text-align: left; }
    .g-tbl th.r { text-align: right; } .g-tbl th.c { text-align: center; }
    .g-tbl td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; }
    .g-tbl td.r { text-align: right; } .g-tbl td.c { text-align: center; }
    .g-tbl tr:hover td { background: #f8faff; }
    .rnd { background: var(--accent); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 700; display: inline-block; min-width: 20px; text-align: center; }
    .rw { background: #dcfce7; color: #166534; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 10px; }
    .rd { background: #fef9c3; color: #713f12; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 10px; }
    .rl { background: #fee2e2; color: #991b1b; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 10px; }

    /* CHARTS */
    .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 14px; }
    .ch-card { background: var(--card); border-radius: 10px; padding: 15px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    .ch-card h4 { font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 12px; }
    .ch-wrap { position: relative; height: 200px; }

    /* MODAL */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .modal { background: #fff; border-radius: 14px; width: 100%; max-width: 500px; box-shadow: 0 20px 60px rgba(0,0,0,.25); overflow: hidden; }
    .m-head { padding: 16px 18px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .m-head h3 { font-size: 14px; font-weight: 700; color: var(--primary); }
    .m-close { background: none; border: none; font-size: 18px; cursor: pointer; color: var(--gray); }
    .m-body { padding: 18px; }
    .uz { border: 2px dashed var(--accent); border-radius: 10px; padding: 28px 18px; text-align: center; cursor: pointer; transition: all .2s; background: #f8faff; }
    .uz:hover, .uz.drag { border-color: var(--green); background: #f0fdf4; }
    .uz.done { border-color: var(--green); background: #f0fdf4; }
    .uz-icon { font-size: 28px; margin-bottom: 7px; }
    .uz h4 { font-size: 13px; font-weight: 600; color: var(--primary); margin-bottom: 3px; }
    .uz p { font-size: 11px; color: var(--gray); }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 13px; }
    .fg label { display: block; font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
    .fg input, .fg select { width: 100%; }
    .m-foot { padding: 12px 18px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }

    /* BUTTONS */
    .btn { padding: 7px 15px; border-radius: 7px; font-size: 12px; font-weight: 600; border: none; cursor: pointer; font-family: inherit; transition: all .15s; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-primary:disabled { background: #93c5fd; cursor: not-allowed; }
    .btn-ghost { background: transparent; color: var(--gray); border: 1.5px solid var(--border); }
    .btn-ghost:hover { background: var(--bg); }
    .btn-danger-sm { background: #fee2e2; color: var(--red); border: none; border-radius: 5px; padding: 3px 7px; font-size: 10px; font-weight: 700; cursor: pointer; }
    .btn-danger-sm:hover { background: #fecaca; }

    /* EMPTY */
    .empty { text-align: center; padding: 60px 20px; }
    .empty .ei { font-size: 44px; margin-bottom: 10px; }
    .empty h3 { font-size: 15px; color: var(--primary); font-weight: 700; margin-bottom: 6px; }
    .empty p { font-size: 12px; color: var(--gray); max-width: 280px; margin: 0 auto 14px; line-height: 1.6; }

    /* TOP TABLE (dashboard) */
    .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 14px; }

    /* MOBILE */
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .app { flex-direction: column; height: auto; overflow: visible; }
      .main { overflow-y: visible; }
      .m-nav { display: flex; background: var(--primary); overflow-x: auto; padding: 6px 8px; gap: 4px; flex-shrink: 0; }
      .stats { grid-template-columns: 1fr 1fr; }
      .form-grid { grid-template-columns: 1fr; }
      .charts { grid-template-columns: 1fr; }
    }
    @media (min-width: 769px) { .m-nav { display: none; } }
    .m-nav-btn { background: none; border: none; color: rgba(255,255,255,.65); padding: 7px 13px; border-radius: 7px; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; font-family: inherit; }
    .m-nav-btn.active { background: rgba(255,255,255,.15); color: #fff; }
  </style>
</head>
<body>

<!-- MODAL -->
<div class="overlay" id="overlay" style="display:none" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <div class="m-head">
      <h3>Agregar torneo</h3>
      <button class="m-close" onclick="closeModal()">✕</button>
    </div>
    <div class="m-body">
      <div class="uz" id="uz" onclick="document.getElementById('fi').click()"
           ondragover="dg(event,'drag')" ondragleave="dg(event,'')" ondrop="dp(event)">
        <div class="uz-icon">📂</div>
        <h4>Arrastra tu archivo .TUNX aquí</h4>
        <p>Descargado desde Chess-Results → Swiss-Manager tournament file</p>
        <input type="file" id="fi" accept=".TUNX,.tunx" onchange="onFile(this.files[0])" style="display:none">
      </div>
      <div class="form-grid">
        <div class="fg">
          <label>Nombre</label>
          <input type="text" id="iName" placeholder="Panamericano U17 2026">
        </div>
        <div class="fg">
          <label>Categoría</label>
          <select id="iCat">
            <option value="">Sin categoría</option>
            <option value="U7">U7</option><option value="U8">U8</option>
            <option value="U10">U10</option><option value="U12">U12</option>
            <option value="U14">U14</option><option value="U16">U16</option>
            <option value="U17" selected>U17</option><option value="U18">U18</option>
            <option value="U7F">U7 Femenino</option><option value="U8F">U8 Femenino</option>
            <option value="U10F">U10 Femenino</option><option value="U12F">U12 Femenino</option>
            <option value="U14F">U14 Femenino</option><option value="U16F">U16 Femenino</option>
            <option value="U18F">U18 Femenino</option>
            <option value="Open">Abierto</option><option value="F">Femenino</option>
          </select>
        </div>
        <div class="fg">
          <label>Sede</label>
          <input type="text" id="iLoc" placeholder="Sonsonate, El Salvador">
        </div>
        <div class="fg">
          <label>Año</label>
          <input type="number" id="iYear" value="2026" min="2000" max="2100">
        </div>
      </div>
    </div>
    <div class="m-foot">
      <button class="btn btn-ghost" onclick="closeModal()">Cancelar</button>
      <button class="btn btn-primary" id="btnSave" onclick="saveTournament()" disabled>Guardar</button>
    </div>
  </div>
</div>

<!-- APP -->
<div class="app">
  <nav class="sidebar">
    <div class="sb-head">
      <h1>♟ Chess Elo</h1>
      <p>Gestor multi-torneo para entrenadores</p>
    </div>
    <div class="sb-label">Vistas</div>
    <div style="padding:0 8px">
      <button class="sb-item active" id="nav-dashboard" onclick="go('dashboard')">
        <span class="icon">🏠</span>
        <div class="info"><div class="title">Dashboard</div></div>
      </button>
      <button class="sb-item" id="nav-players" onclick="go('players')">
        <span class="icon">👥</span>
        <div class="info"><div class="title">Todos los jugadores</div><div class="sub" id="sb-total">0 jugadores</div></div>
      </button>
    </div>
    <div class="sb-label">Torneos</div>
    <div class="sb-scroll" id="sb-tournaments"></div>
    <button class="sb-add" onclick="openModal()">＋ Agregar torneo (.TUNX)</button>
    <div class="sb-foot">Chess Elo Manager v2.0</div>
  </nav>

  <div class="m-nav" id="m-nav">
    <button class="m-nav-btn active" onclick="go('dashboard')">🏠 Dashboard</button>
    <button class="m-nav-btn" onclick="go('players')">👥 Jugadores</button>
    <button class="m-nav-btn" onclick="openModal()">➕ Torneo</button>
  </div>

  <div class="main">
    <div class="topbar">
      <h2 id="page-title">Dashboard</h2>
      <div class="filters" id="filter-bar" style="display:none">
        <select id="f-fed" onchange="renderPlayers()"><option value="">🌍 Todos los países</option></select>
        <select id="f-cat" onchange="renderPlayers()"><option value="">📚 Todas las categorías</option></select>
        <select id="f-sort" onchange="renderPlayers()">
          <option value="delta">Mayor ΔElo</option>
          <option value="rating">Mayor Rating</option>
          <option value="pts">Más Puntos</option>
          <option value="name">Nombre A-Z</option>
        </select>
      </div>
    </div>
    <div class="content" id="content"></div>
  </div>
</div>

