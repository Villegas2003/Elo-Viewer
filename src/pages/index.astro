      const lo2=rating&0xff, hi2=(rating>>8)&0xff;
      for (let p=8000; p<data.length-1; p++) {
        if (data[p]!==lo2||data[p+1]!==hi2) continue;
        const bs=Math.max(0,p-300), blk=data.slice(bs,p+60);
        let j=0, strs=[];
        while (j<blk.length-1) {
          if (blk[j]>=65&&blk[j]<=122&&blk[j+1]===0) {
            let s='',k=j;
            while(k<blk.length-1&&blk[k]>=32&&blk[k]<=126&&blk[k+1]===0){s+=String.fromCharCode(blk[k]);k+=2;}
            if(s.length>=2)strs.push(s);j=k;
          } else j++;
        }
        for (const s of strs) {
          if (s.length>=4&&s.includes(' ')&&!name) name=s;
          if (TITLES_LIST.includes(s)) title=s;
          if (s.length===3&&s===s.toUpperCase()&&!fed) fed=s;
        }
        break;
      }
    }
    players[rank] = {n:name||`Player ${rank}`, t:title, f:fed||'???', g:rating};
  }
  return {players, games};
}

// ═══════════════════════════════════════════
// ELO — FÓRMULA FIDE OFICIAL
// ΔRating = K × Σ(resultado_i − expected_i)
// ═══════════════════════════════════════════
const exp = (ra,rb) => rb>0 ? 1/(1+Math.pow(10,(rb-ra)/400)) : null;

function calcDelta(rating, games, players, K=40) {
  let total=0, cnt=0;
  for (const g of games) {
    const opp = players[g.o] || players[String(g.o)];
    const e = opp ? exp(rating, opp.g) : null;
    if (e===null) continue;
    total += K*(g.r-e); cnt++;
  }
  return {delta: Math.round(total*10)/10, cnt};
}

