  var tfTeam=document.getElementById('tf-team');
  if (tfTeam) tfTeam.addEventListener('change', function(){ renderTT(tid); });
  // Search en standings por equipo (filtra rows in-place sin re-render)
  var teamSearch=document.getElementById('team-search');
  if (teamSearch) teamSearch.addEventListener('input', function(){
    var q=teamSearch.value.trim().toLowerCase();
    var rows=document.querySelectorAll('#team-tbody tr.team-row');
    var visible=0;
    rows.forEach(function(r){
      var tm=r.getAttribute('data-team')||'';
      var show=!q || tm.indexOf(q)>=0;
      r.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var cnt=document.getElementById('team-count');
    if (cnt) cnt.textContent = q ? visible+' / '+rows.length+' equipos' : rows.length+' equipos';
  });
  var matchSearch=document.getElementById('match-search');
  if (matchSearch) matchSearch.addEventListener('input', function(){
    var q=matchSearch.value.trim().toLowerCase();
    var rows=document.querySelectorAll('#match-tbody tr.match-row');
    var visible=0;
    rows.forEach(function(r){
      var tms=r.getAttribute('data-teams')||'';
      var show=!q || tms.indexOf(q)>=0;
      r.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var cnt=document.getElementById('match-count');
    if (cnt) cnt.textContent = q ? visible+' / '+rows.length+' matches' : rows.length+' matches';
  });
  var refreshBtn = document.getElementById('cr-refresh');
  if (refreshBtn) refreshBtn.addEventListener('click', function(){ manualRefreshCR(tid); });
  var renameBtnEl = document.getElementById('t-rename');
  if (renameBtnEl) renameBtnEl.addEventListener('click', function(){ renameTournament(tid); });
  renderTT(tid);
}

function renameTournament(tid) {
  var t = ST.tournaments.filter(function(x){return x.id===tid;})[0];
  if (!t) return;
  var nw = prompt('Nuevo nombre del torneo:', t.name);
  if (nw === null) return;  // cancel
  nw = nw.trim();
  if (!nw) { toast('error', 'El nombre no puede estar vacío'); return; }
  if (nw === t.name) return;
  t.name = nw;
  saveST();
  renderSB();
  renderTournament(tid);
  toast('success', 'Torneo renombrado a "' + nw + '"');
}

function renderTT(tid) {
  var t=ST.tournaments.filter(function(x){return x.id===tid;})[0];
  if(!t)return;
  var fed=document.getElementById('tf-fed')?document.getElementById('tf-fed').value:'';
  var sort=document.getElementById('tf-sort')?document.getElementById('tf-sort').value:'delta';
  var tSearchEl=document.getElementById('tf-search');
  var q=(tSearchEl?tSearchEl.value:'').trim().toLowerCase();
  var tTeamEl=document.getElementById('tf-team');
  var team=tTeamEl?tTeamEl.value:'';
  var list=getPlayers([tid]);
  if(fed)list=list.filter(function(p){return p.f===fed;});
  if(team)list=list.filter(function(p){return p.team===team;});
  if(q)list=list.filter(function(p){
    return (p.n||'').toLowerCase().indexOf(q)>=0
      || (p.team||'').toLowerCase().indexOf(q)>=0
      || (p.t||'').toLowerCase().indexOf(q)>=0;
  });
  var sortFn={delta:function(a,b){return b.delta-a.delta;},rating:function(a,b){return b.g-a.g;},pts:function(a,b){return b.pts-a.pts;}};
  list.sort(sortFn[sort]||sortFn.delta);
  if(CH.tc1){try{CH.tc1.destroy();}catch(e){}delete CH.tc1;}
  var ctx=document.getElementById('tc1');
  if(ctx&&list.length){
    var d=list.map(function(p){return p.delta;});
    var c=chartColors();
    CH.tc1=new Chart(ctx,{
      type:'bar',
      data:{labels:list.map(function(p){return p.n.split(',')[0];}),datasets:[{label:'ΔElo',data:d,backgroundColor:d.map(function(v){return v>0?c.pos:c.neg;}),borderRadius:6,borderSkipped:false}]},
      options: chartBarOpts()
    });
  }
  var tb=document.getElementById('t-tbody');
  if(tb){tb.innerHTML=pRows(list,'t'+tid);addRowListeners();}
}

function addRowListeners() {
  document.querySelectorAll('.trow[data-rowid]').forEach(function(tr){
    var handler = function(){
      var id=tr.dataset.rowid;
      var gr=document.getElementById('gr-'+id);
      if(!gr)return;
      var open=gr.classList.toggle('open');
      tr.setAttribute('aria-expanded', open?'true':'false');
    };
    tr.addEventListener('click', handler);
    tr.addEventListener('keydown', function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); handler(); }
    });
  });
}

