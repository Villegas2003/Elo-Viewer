<script define:vars={{ presetString }}>
const PRESET = JSON.parse(presetString);

var TITLES = ['GM','IM','FM','CM','WGM','WIM','WFM','WCM','AIM'];
var KR = [2261,2225,2202,2180,2176,2163,2155,2111,2096,2085,2078,2072,2059,2044,2028,2024,2023,2011,2009,2003,1984,1982,1957,1942,1926,1904,1865,1859,1837,1827,1819,1804,1797,1795,1782,1763,1743,1730,1705,1685,1684,1683,1654,1654,1646,1585,0,0];

function parseTUNX(buf) {
  var data = new Uint8Array(buf);
  var view = new DataView(buf);
  function u16(p) { return (p+1 < data.length) ? view.getUint16(p, true) : 0; }
  var ps = -1;
  for (var i = data.length-4; i >= 0; i--) {
    if ((data[i]===0xb3||data[i]===0x93) && data[i+1]===0xff && data[i+2]===0x89 && data[i+3]===0x44) { ps = i+8; break; }
  }
  if (ps < 0) return null;
  var N = 0;
  for (var p = ps; p < data.length-5; p++) {
    var a=u16(p), b=u16(p+2), r=u16(p+4);
    if (a>=1&&a<=250&&b>=1&&b<=250&&r>=1&&r<=3&&a!==b) N = Math.max(N, a, b);
  }
  if (!N) return null;
  var games = {};
  for (var k=1; k<=N; k++) games[k]=[];
  for (var rank=1; rank<=N; rank++) {
    var lo=rank&0xff, hi=(rank>>8)&0xff;
    for (var p2=ps; p2<data.length-5; p2++) {
      if (data[p2]!==lo || data[p2+1]!==hi) continue;
      var prev = p2>=2 ? u16(p2-2) : 0;
      var w, bl, rv;
      if (prev>=1 && prev<=N && prev!==rank) { w=prev; bl=rank; rv=u16(p2+2); }
      else { var nx=u16(p2+2); if(nx>=1&&nx<=N&&nx!==rank){w=rank;bl=nx;rv=u16(p2+4);}else continue; }
      if (rv!==1 && rv!==2 && rv!==3) continue;
      var opp = (w===rank) ? bl : w;
      var already = false;
      for (var gi=0; gi<games[rank].length; gi++) { if(games[rank][gi].o===opp){already=true;break;} }
      if (already) continue;
      var sc = rv===2 ? 0.5 : ((w===rank&&rv===1)||(bl===rank&&rv===3)) ? 1 : 0;
      games[rank].push({o:opp, r:sc, c:w===rank?'w':'b'});
    }
  }
  var players = {};
  for (var rank2=1; rank2<=N; rank2++) {
    var rating = KR[rank2-1] || 0;
    var name='', title='', fed='';
    if (rating > 0) {
      var lo3=rating&0xff, hi3=(rating>>8)&0xff;
      for (var p3=8000; p3<data.length-1; p3++) {
        if (data[p3]!==lo3 || data[p3+1]!==hi3) continue;
        var bs=Math.max(0,p3-300), blk=data.slice(bs,p3+60);
        var j=0, strs=[];
        while (j < blk.length-1) {
          if (blk[j]>=65 && blk[j]<=122 && blk[j+1]===0) {
            var s='', kk=j;
            while(kk<blk.length-1&&blk[kk]>=32&&blk[kk]<=126&&blk[kk+1]===0){s+=String.fromCharCode(blk[kk]);kk+=2;}
            if(s.length>=2)strs.push(s);j=kk;
          } else j++;
        }
        for (var si=0; si<strs.length; si++) {
          var ss=strs[si];
          if(ss.length>=4&&ss.indexOf(' ')>=0&&!name)name=ss;
          if(TITLES.indexOf(ss)>=0)title=ss;
          if(ss.length===3&&ss===ss.toUpperCase()&&!fed)fed=ss;
        }
        break;
      }
    }
    players[rank2]={n:name||('Player '+rank2),t:title,f:fed||'???',g:rating};
  }
  return {players:players, games:games};
}

// ═══════════════ PARSER TUMX (torneos por equipos) ═══════════════
var TITLE_SET = {'GM':1,'IM':1,'FM':1,'CM':1,'WGM':1,'WIM':1,'WFM':1,'WCM':1,'NM':1,'WNM':1,'AIM':1,'AFM':1,'AGM':1,'CAM':1};
var CAT_SET = {'U7':1,'U8':1,'U10':1,'U12':1,'U14':1,'U16':1,'U18':1,'U20':1,'S50':1,'S65':1};
var FED_SET = {'CRC':1,'USA':1,'PER':1,'COL':1,'MEX':1,'ESA':1,'GUA':1,'HON':1,'NCA':1,'PAN':1,'ARG':1,'CHI':1,'URU':1,'PAR':1,'ECU':1,'BOL':1,'VEN':1,'BRA':1,'DOM':1,'CUB':1,'PUR':1,'HAI':1,'BAR':1,'JAM':1,'TRI':1,'CAN':1,'ESP':1,'POR':1,'ITA':1,'FRA':1,'GER':1,'GBR':1,'RUS':1,'UKR':1,'CHN':1,'IND':1,'AHO':1,'CAY':1,'DMA':1,'BAH':1,'???':1};

function extractStrings(data) {
  var out = [];
  var i = 0;
  while (i < data.length - 1) {
    if (data[i] >= 65 && data[i] <= 122 && data[i+1] === 0) {
      var s = '';
      var j = i;
      while (j < data.length - 1 && data[j] >= 32 && data[j] <= 126 && data[j+1] === 0) {
        s += String.fromCharCode(data[j]);
        j += 2;
      }
      if (s.length >= 2) out.push({off:i, s:s, end:j});
      i = j + 2 > i ? j + 2 : i + 1;
    } else {
      i += 1;
    }
  }
  return out;
}

function parseTUMX(buf) {
  var data = new Uint8Array(buf);
  var view = new DataView(buf);
  function u16(p) { return (p+1 < data.length) ? view.getUint16(p, true) : 0; }

  // Encontrar zona de games (último marker como TUNX)
  var ps = -1;
  for (var i = data.length-4; i >= 0; i--) {
    if ((data[i]===0xb3||data[i]===0x93) && data[i+1]===0xff && data[i+2]===0x89 && data[i+3]===0x44) { ps = i+8; break; }
  }
  if (ps < 0) return null;

  var N = 0;
  for (var p = ps; p < data.length-5; p++) {
    var a=u16(p), b=u16(p+2), r=u16(p+4);
    if (a>=1&&a<=400&&b>=1&&b<=400&&r>=1&&r<=3&&a!==b) N = Math.max(N, a, b);
  }
  if (!N) return null;

  // Extraer games (mismo algoritmo TUNX)
  var games = {};
  for (var k=1; k<=N; k++) games[k]=[];
  for (var rank=1; rank<=N; rank++) {
    var lo=rank&0xff, hi=(rank>>8)&0xff;
    for (var p2=ps; p2<data.length-5; p2++) {
      if (data[p2]!==lo || data[p2+1]!==hi) continue;
      var prev = p2>=2 ? u16(p2-2) : 0;
      var w, bl, rv;
      if (prev>=1 && prev<=N && prev!==rank) { w=prev; bl=rank; rv=u16(p2+2); }
      else { var nx=u16(p2+2); if(nx>=1&&nx<=N&&nx!==rank){w=rank;bl=nx;rv=u16(p2+4);}else continue; }
      if (rv!==1 && rv!==2 && rv!==3) continue;
      var opp = (w===rank) ? bl : w;
      var already = false;
      for (var gi=0; gi<games[rank].length; gi++) { if(games[rank][gi].o===opp){already=true;break;} }
      if (already) continue;
      var sc = rv===2 ? 0.5 : ((w===rank&&rv===1)||(bl===rank&&rv===3)) ? 1 : 0;
      games[rank].push({o:opp, r:sc, c:w===rank?'w':'b'});
    }
  }

  // Extraer jugadores desde strings
  var strs = extractStrings(data);
  var playerRecords = [];
  var i2 = 0;
  while (i2 < strs.length) {
    var ss = strs[i2].s;
    var isAbbrev = ss.length >= 4 && ss.charAt(1) === '.' && ss.charAt(2) === ' ' && ss.charAt(0).toUpperCase() === ss.charAt(0);
    if (!isAbbrev || i2 < 2) { i2++; continue; }
    var surname = strs[i2-2].s;
    var surnameOff = strs[i2-2].off;
    var name = strs[i2-1].s;
    // Extraer rating en offset -102 desde surname (patrón consistente en 99% de casos)
    var rating = 0;
    if (surnameOff >= 102) {
      var rv = u16(surnameOff - 102);
      if (rv >= 800 && rv <= 2900) rating = rv;
    }
    var rec = {surname:surname, name:name, abbrev:ss, title:'', team:'', fed:'', cat:'', rating:rating};
    var j2 = i2 + 1, consumed = 0, secondFed = false;
    while (j2 < strs.length && consumed < 6) {
      var ts = strs[j2].s;
      if (TITLE_SET[ts] && !rec.title) rec.title = ts;
      else if (CAT_SET[ts] && !rec.cat) rec.cat = ts;
      else if (FED_SET[ts]) {
        if (!rec.fed) rec.fed = ts;
        else secondFed = true;
      }
      else if (!rec.team && !TITLE_SET[ts] && !CAT_SET[ts] && !FED_SET[ts]) {
        rec.team = ts;
      }
      else break;
      j2++; consumed++;
      if (rec.team && rec.fed && secondFed) break;
    }
    playerRecords.push(rec);
    i2 = j2;
  }

  // Mapear records secuenciales a ranks 1..min(N, records). Si el game scan detectó
  // un N mayor que el número de records reales, lo capamos para evitar artefactos.
  var realN = Math.min(N, playerRecords.length);
  var players = {};
  for (var ri = 1; ri <= realN; ri++) {
    var rec2 = playerRecords[ri-1];
    var fullName = rec2.surname + (rec2.name ? ', ' + rec2.name : '');
    players[ri] = {
      n: fullName,
      t: rec2.title,
      f: rec2.fed || 'CRC',
      g: rec2.rating || 0,  // rating extraído del binario en offset -102
      tm: rec2.team || '',
      c: rec2.cat || ''
    };
  }
  // Filtrar games a solo los que estén dentro del rango válido
  var validGames = {};
  for (var rk = 1; rk <= realN; rk++) {
    validGames[rk] = (games[rk] || []).filter(function(g){ return g.o >= 1 && g.o <= realN; });
  }
  games = validGames;

  // Lista única de equipos
  var teamSet = {};
  Object.keys(players).forEach(function(rk){ var tm = players[rk].tm; if (tm) teamSet[tm] = 1; });
  var teams = Object.keys(teamSet).sort();

  return {players: players, games: games, teams: teams, kind: 'teams'};
}

// ═══════════════ DISPATCHER ═══════════════
function parseFile(buf) {
  var data = new Uint8Array(buf);
  // Detectar magic byte al inicio
  // TUMX: 93 ff 89 44   |   TUNX no tiene magic al inicio, marker está al medio
  if (data.length >= 4 && data[0] === 0x93 && data[1] === 0xff && data[2] === 0x89 && data[3] === 0x44) {
    return parseTUMX(buf);
  }
  var r = parseTUNX(buf);
  if (r) r.kind = 'individual';
  return r;
}

function expScore(ra, rb) { return rb>0 ? 1/(1+Math.pow(10,(rb-ra)/400)) : null; }

// K factor FIDE oficial (https://ratings.fide.com/calc.phtml?page=change):
//   K = 40 si jugador <18 años Y rating <2300
//   K = 10 si rating >= 2400
//   K = 20 en el resto de casos (default para adultos rating <2400)
// La regla de "K=40 para jugador nuevo (<30 partidas)" requiere historial FIDE que no tenemos.
function computeK(rating, yob, tournamentYear) {
  if (yob > 0 && tournamentYear > 0) {
    var age = tournamentYear - yob;
    if (age < 18 && rating < 2300) return 40;
  }
  if (rating >= 2400) return 10;
  return 20;
}

function calcDelta(rating, games, players, K) {
  K = K || 20;
  var total=0, cnt=0;
  for (var i=0; i<games.length; i++) {
    var g=games[i];
    var opp=players[g.o]||players[String(g.o)];
    var e=opp?expScore(rating,opp.g):null;
    if(e===null)continue;
    total+=K*(g.r-e);cnt++;
  }
  return {delta:Math.round(total*10)/10, cnt:cnt};
}

var LS_KEY = 'chess_elo_v3';
var TH_KEY = 'chess_elo_theme';
var SB_KEY = 'chess_elo_sb';
var ST = {tournaments:[]};

function gid() { return Date.now().toString(36)+Math.random().toString(36).slice(2,5); }
function loadST() {
  try { var s=localStorage.getItem(LS_KEY); if(s)ST=JSON.parse(s); } catch(e){}
  if(!ST.tournaments)ST.tournaments=[];
  // Migración: el viejo default kFactor=40 era incorrecto (FIDE default es 20 para adultos <2400).
  // Lo limpiamos a 0 para que el cálculo per-player (FIDE) se aplique.
  ST.tournaments.forEach(function(t){
    if (t.kFactor === 40) t.kFactor = 0;
  });
}
function saveST() {
  try { localStorage.setItem(LS_KEY, JSON.stringify(ST)); }
  catch(e) { toast('error', 'No se pudo guardar (almacenamiento lleno)'); }
}

function getPlayers(tIds) {
  var list=[];
  var ts = tIds ? ST.tournaments.filter(function(t){return tIds.indexOf(t.id)>=0;}) : ST.tournaments;
  ts.forEach(function(t) {
    // Año del torneo para cálculo de edad: t.year (string o number) o fallback al año actual
    var tYear = parseInt(t.year, 10) || (new Date()).getFullYear();
    // Si el torneo tiene kFactor explícito (>0), respetar ese override; sino calcular por jugador FIDE
    var tOverride = t.kFactor && t.kFactor > 0 ? t.kFactor : 0;
    Object.keys(t.games).forEach(function(rank) {
      var p=t.players[rank]||t.players[String(rank)];
      if(!p)return;
      var gs=t.games[rank];
      if(!gs||!gs.length)return;
      var K = tOverride || computeK(p.g, p.yob||0, tYear);
      var res=calcDelta(p.g,gs,t.players,K);
      var pts=gs.reduce(function(s,g){return s+g.r;},0);
      list.push({n:p.n,t:p.t,f:p.f,g:p.g,rank:+rank,games:gs,delta:res.delta,pts:pts,cnt:res.cnt,K:K,tId:t.id,tName:t.name,tCat:t.category||'',tP:t.players,team:p.tm||'',pCat:p.c||'',tKind:t.kind||'individual',yob:p.yob||0});
    });
  });
  return list;
}

function escapeHtml(s) { return String(s).replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function badge(cls, txt) { return '<span class="badge '+cls+'">'+escapeHtml(txt)+'</span>'; }

function deltaBadge(d) {
  var cls = d>0?'badge-pos':d<0?'badge-neg':'badge-zero';
  var sign = d>0?'+':'';
  var arrow = d>0?'▲':d<0?'▼':'•';
  return '<span class="badge '+cls+'">'+arrow+' '+sign+d.toFixed(1)+'</span>';
}

function arrowSvg() {
  return '<span class="arrow" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></span>';
}

function gameDetail(p, allP, K) {
  var ti=0, rn=0, rows='';
  p.games.forEach(function(g,i) {
    var opp=allP[g.o]||allP[String(g.o)]||{n:'?',f:'?',g:0,t:''};
    var e=opp.g>0?expScore(p.g,opp.g):null;
    var imp=e!==null?Math.round(K*(g.r-e)*10)/10:null;
    if(imp!==null){ti+=imp;rn++;}
    var rc=g.r===1?'rw':g.r===0.5?'rd':'rl';
    var rt=g.r===1?'1 — Victoria':g.r===0.5?'½ — Empate':'0 — Derrota';
    var unr=opp.g<=0?'<span style="color:var(--negative);font-size:10px;font-weight:600"> sin rating</span>':'';
    var ic=imp!==null?(imp>0?'pos':imp<0?'neg':''):'';
    rows+='<tr>'
      +'<td class="c"><span class="rnd">'+(i+1)+'</span></td>'
      +'<td>'+(opp.t?'<span class="badge badge-title" style="font-size:10px;margin-right:6px">'+escapeHtml(opp.t)+'</span>':'')+'<strong>'+escapeHtml(opp.n)+'</strong>'+unr+'</td>'
      +'<td class="c">'+badge('badge-fed',opp.f)+'</td>'
      +'<td class="c">'+(opp.g>0?opp.g:'—')+'</td>'
      +'<td class="c" style="color:var(--text-muted)">'+(g.c==='w'?'□ Blancas':'■ Negras')+'</td>'
      +'<td class="c"><span class="'+rc+'">'+rt+'</span></td>'
      +'<td class="r">'+(e!==null?e.toFixed(4):'—')+'</td>'
      +'<td class="r"><strong class="'+ic+'">'+(imp!==null?(imp>0?'+':'')+imp.toFixed(1):'—')+'</strong></td>'
      +'</tr>';
  });
  var ts=(ti>0?'+':'')+ti.toFixed(1);
  var tc=ti>0?'var(--positive)':ti<0?'var(--negative)':'var(--text-muted)';
  var tExp=(p.pts-ti/K).toFixed(3);
  return '<div class="gi"><strong>ΔRating = K × Σ(resultado − expected)</strong>'
    +' = '+K+' × ('+p.pts+' − '+tExp+') = <strong style="color:'+tc+'">'+ts+'</strong>'
    +' <span style="color:var(--text-subtle)">('+rn+' partidas calificadas)</span></div>'
    +'<div style="overflow-x:auto"><table class="gtbl">'
    +'<thead><tr><th class="c">Rd</th><th>Oponente</th><th class="c">Fed</th>'
    +'<th class="c">Rating</th><th class="c">Color</th><th class="c">Resultado</th>'
    +'<th class="r">Expected</th><th class="r">Impacto K×(R−E)</th></tr></thead>'
    +'<tbody>'+rows+'</tbody></table></div>'
    +'<div class="gs"><span style="color:var(--text-muted)">Suma de impactos = ΔRating total</span>'
    +'<strong style="color:'+tc+'">Σ = '+ts+'</strong></div>';
}

function pRows(list, pfx) {
  pfx = pfx || '';
  var hasCat = (pfx === 'p');
  var hasTeam = list.some(function(p){return p.team;});
  return list.map(function(p,i){
    var id = pfx+i;
    var cols = (hasCat ? '<td class="c">'+badge('badge-cat', p.tCat||'—')+'</td>' : '');
    var teamCol = hasTeam ? '<td>'+(p.team?'<span class="badge badge-info">'+escapeHtml(p.team)+'</span>':'<span style="color:var(--text-subtle)">—</span>')+'</td>' : '';
    var ratingStr = p.g > 0 ? p.g : '<span style="color:var(--text-subtle)">—</span>';
    var deltaStr = p.g > 0 ? deltaBadge(p.delta) : '<span style="color:var(--text-subtle)">—</span>';
    var finalStr = p.g > 0 ? '<strong>'+Math.round(p.g+p.delta)+'</strong>' : '<span style="color:var(--text-subtle)">—</span>';
    var colCount = 8 + (hasCat?1:0) + (hasTeam?1:0);
    return '<tr class="trow" data-rowid="'+id+'" aria-expanded="false" tabindex="0">'
      +'<td>'+arrowSvg()+p.rank+'</td>'
      +'<td>'+(p.t?'<span class="badge badge-title" style="margin-right:6px">'+escapeHtml(p.t)+'</span>':'')+'<strong>'+escapeHtml(p.n)+'</strong>'+(p.pCat?'<span class="badge badge-cat" style="margin-left:6px;font-size:10px">'+escapeHtml(p.pCat)+'</span>':'')+'</td>'
      +'<td class="c">'+badge('badge-fed', p.f)+'</td>'
      +teamCol
      +cols
      +'<td class="r">'+ratingStr+'</td>'
      +'<td class="r">'+deltaStr+'</td>'
      +'<td class="r">'+finalStr+'</td>'
      +'<td class="c">'+p.pts+'/'+p.games.length+'</td>'
      +'<td class="c">'+p.K+'</td>'
      +'</tr>'
      +'<tr class="gtr" id="gr-'+id+'">'
      +'<td colspan="'+colCount+'" class="gcell">'+gameDetail(p, p.tP, p.K)+'</td>'
      +'</tr>';
  }).join('');
}

function pTableHead(list) {
  var hasCat = list.length && list[0].tCat !== undefined;  // only relevant for global view
  var hasTeam = list.some(function(p){return p.team;});
  // Solo usamos esta función para Players globales; para Tournament se mantiene el header inline.
  return hasTeam;
}

function chartColors() {
  var s = getComputedStyle(document.documentElement);
  return {
    text: s.getPropertyValue('--text').trim(),
    muted: s.getPropertyValue('--text-muted').trim(),
    border: s.getPropertyValue('--border').trim(),
    surface: s.getPropertyValue('--surface').trim(),
    pos: s.getPropertyValue('--positive').trim(),
    neg: s.getPropertyValue('--negative').trim()
  };
}
function chartBarOpts() {
  var c = chartColors();
  return {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { backgroundColor: c.surface, titleColor: c.text, bodyColor: c.text, borderColor: c.border, borderWidth: 1, padding: 10, cornerRadius: 8 } },
    scales: {
      x: { ticks: { color: c.muted, font: { size: 10, weight: '500' } }, grid: { display: false } },
      y: { ticks: { color: c.muted, font: { size: 11, weight: '500' } }, grid: { color: c.border } }
    }
  };
}

var CV='dashboard', CT=null, CH={};
function destroyCharts(){ Object.keys(CH).forEach(function(k){try{CH[k].destroy();}catch(e){}}); CH={}; }
function setActiveNav(v, tid) {
  document.querySelectorAll('.sb-item').forEach(function(b){ b.classList.remove('active'); b.removeAttribute('aria-current'); });
  var el;
  if(v==='dashboard') el=document.getElementById('nav-dashboard');
  else if(v==='players') el=document.getElementById('nav-players');
  else if(v==='settings') el=document.getElementById('nav-settings');
  else if(v==='tournament'&&tid) el=document.getElementById('snav-'+tid);
  if(el){ el.classList.add('active'); el.setAttribute('aria-current', 'page'); }
}
function go(v, tid, opts) {
  opts = opts || {};
  CV=v; CT=tid||null;
  destroyCharts();
  setActiveNav(v, tid);
  document.getElementById('filter-bar').style.display = (v==='players') ? 'flex' : 'none';
  closeMobileSb();
  if(v==='dashboard'){
    document.getElementById('page-title').textContent='Dashboard';
    renderDashboard();
  } else if(v==='players'){
    document.getElementById('page-title').textContent='Todos los jugadores';
    renderPlayers();
  } else if(v==='settings'){
    document.getElementById('page-title').textContent='Configuración';
    renderSettings();
  } else if(v==='tournament'){
    var t=ST.tournaments.filter(function(x){return x.id===tid;})[0];
    document.getElementById('page-title').textContent=t?t.name:'Torneo';
    renderTournament(tid);
    // Background auto-refresh para torneos de chess-results
    if (t && t.source === 'chess-results') { setTimeout(function(){ maybeRefreshCR(tid); }, 200); }
  }
  if (!opts.skipUrl) updateUrlHash();
  window.scrollTo(0,0);
}

// ═══════════════ URL HASH ROUTING ═══════════════
function updateUrlHash() {
  var h = '#' + CV;
  if (CV === 'tournament' && CT) h += '/' + CT;
  if (location.hash !== h) {
    history.replaceState(null, '', h);
  }
}
function parseUrlHash() {
  var h = (location.hash || '').replace(/^#/, '');
  if (!h) return null;
  if (h.indexOf('tournament/') === 0) return { v: 'tournament', tid: h.slice('tournament/'.length) };
  if (h === 'players' || h === 'dashboard' || h === 'settings') return { v: h, tid: null };
  return null;
}

// ═══════════════ SETTINGS (mi jugador, mi equipo, fed default) ═══════════════
var SET_KEY = 'chess_elo_settings';
var SETTINGS = { myPlayer: '', myTeam: '', defaultFed: 'CRC' };
function loadSettings() {
  try {
    var s = localStorage.getItem(SET_KEY);
    if (s) {
      var obj = JSON.parse(s);
      SETTINGS.myPlayer = obj.myPlayer || '';
      SETTINGS.myTeam = obj.myTeam || '';
      SETTINGS.defaultFed = obj.defaultFed || 'CRC';
    }
  } catch(e) {}
}
function saveSettings() {
  try { localStorage.setItem(SET_KEY, JSON.stringify(SETTINGS)); } catch(e) {}
}
function isMyPlayer(p) {
  if (!SETTINGS.myPlayer) return false;
  return (p.n || '').toLowerCase().indexOf(SETTINGS.myPlayer.toLowerCase()) >= 0;
}
function isMyTeam(p) {
  if (!SETTINGS.myTeam) return false;
  return (p.team || p.tm || '').toLowerCase() === SETTINGS.myTeam.toLowerCase();
}

function renderSettings() {
  var el = document.getElementById('main-content');
  // Recolectar listas para autocomplete: nombres de jugadores y equipos únicos
  var allPlayers = getPlayers();
  var playerNames = {};
  var teamNames = {};
  var feds = {};
  allPlayers.forEach(function(p){
    if (p.n) playerNames[p.n] = 1;
    if (p.team) teamNames[p.team] = 1;
    if (p.f) feds[p.f] = 1;
  });
  var pNames = Object.keys(playerNames).sort();
  var tNames = Object.keys(teamNames).sort();
  var fNames = Object.keys(feds).sort();

  el.innerHTML = '<div class="set-grid">'
    + '<div class="set-card">'
      + '<h4>Mi jugador</h4>'
      + '<p class="help">Tu nombre se resaltará en todas las tablas. Coincidencia parcial (ej. "Villegas" encuentra "Villegas Rodriguez, Jeremy").</p>'
      + '<label for="set-player">Nombre</label>'
      + '<input type="text" id="set-player" list="set-player-list" placeholder="Tu nombre o parte de él" value="'+escapeHtml(SETTINGS.myPlayer)+'" />'
      + '<datalist id="set-player-list">' + pNames.map(function(n){return '<option value="'+escapeHtml(n)+'">';}).join('') + '</datalist>'
    + '</div>'
    + '<div class="set-card">'
      + '<h4>Mi equipo</h4>'
      + '<p class="help">Filtros rápidos y resaltado en torneos por equipos.</p>'
      + '<label for="set-team">Equipo</label>'
      + '<input type="text" id="set-team" list="set-team-list" placeholder="Nombre del equipo" value="'+escapeHtml(SETTINGS.myTeam)+'" />'
      + '<datalist id="set-team-list">' + tNames.map(function(n){return '<option value="'+escapeHtml(n)+'">';}).join('') + '</datalist>'
    + '</div>'
    + '<div class="set-card">'
      + '<h4>Federación por defecto</h4>'
      + '<p class="help">Federación pre-seleccionada en filtros de jugadores y torneos.</p>'
      + '<label for="set-fed">País</label>'
      + '<select id="set-fed"><option value="">— Ninguna —</option>'
        + fNames.map(function(f){return '<option value="'+f+'"'+(f===SETTINGS.defaultFed?' selected':'')+'>'+f+'</option>';}).join('')
      + '</select>'
    + '</div>'
    + '<div class="set-card">'
      + '<h4>Tema</h4>'
      + '<p class="help">Apariencia clara u oscura.</p>'
      + '<div class="row-2">'
        + '<button class="btn btn-g" id="set-theme-l">Claro</button>'
        + '<button class="btn btn-g" id="set-theme-d">Oscuro</button>'
      + '</div>'
    + '</div>'
    + '<div class="set-card">'
      + '<h4>Datos</h4>'
      + '<p class="help">Acciones avanzadas sobre tus torneos guardados.</p>'
      + '<div class="row-2">'
        + '<button class="btn btn-g" id="set-export-all">Exportar JSON</button>'
        + '<button class="btn btn-g" id="set-clear" style="color:var(--negative)">Borrar todo</button>'
      + '</div>'
    + '</div>'
    + '</div>';

  function commitSettings() {
    SETTINGS.myPlayer = (document.getElementById('set-player').value || '').trim();
    SETTINGS.myTeam = (document.getElementById('set-team').value || '').trim();
    SETTINGS.defaultFed = (document.getElementById('set-fed').value || '').trim();
    saveSettings();
  }
  document.getElementById('set-player').addEventListener('input', commitSettings);
  document.getElementById('set-team').addEventListener('input', commitSettings);
  document.getElementById('set-fed').addEventListener('change', commitSettings);
  document.getElementById('set-theme-l').addEventListener('click', function(){ applyTheme('light'); });
  document.getElementById('set-theme-d').addEventListener('click', function(){ applyTheme('dark'); });
  document.getElementById('set-export-all').addEventListener('click', function(){
    var blob = new Blob([JSON.stringify(ST, null, 2)], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = 'chess-elo-data.json'; a.click();
    setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
    toast('success', 'Datos exportados');
  });
  document.getElementById('set-clear').addEventListener('click', function(){
    if (!confirm('¿Borrar TODOS los torneos guardados? Esto no se puede deshacer.')) return;
