var CV='dashboard', CT=null, CH={};

function destroyCharts(){
  Object.keys(CH).forEach(function(k){try{CH[k].destroy();}catch(e){}});
  CH={};
}

function setActiveNav(v, tid) {
  document.querySelectorAll('.sb-item').forEach(function(b){b.classList.remove('active');});
  document.querySelectorAll('.mn-btn').forEach(function(b){b.classList.remove('active');});
  if(v==='dashboard'){
    document.getElementById('nav-dashboard').classList.add('active');
    document.getElementById('mn-dash').classList.add('active');
  } else if(v==='players'){
    document.getElementById('nav-players').classList.add('active');
    document.getElementById('mn-players').classList.add('active');
  } else if(v==='tournament'&&tid){
    var nb=document.getElementById('snav-'+tid);
    if(nb)nb.classList.add('active');
  }
}

function go(v, tid) {
  CV=v; CT=tid||null;
  destroyCharts();
  setActiveNav(v, tid);
  document.getElementById('filter-bar').style.display=(v==='players')?'flex':'none';
  if(v==='dashboard'){
    document.getElementById('page-title').textContent='Dashboard';
    renderDashboard();
  } else if(v==='players'){
    document.getElementById('page-title').textContent='Todos los jugadores';
    renderPlayers();
  } else if(v==='tournament'){
    var t=ST.tournaments.filter(function(x){return x.id===tid;})[0];
    document.getElementById('page-title').textContent=t?t.name:'Torneo';
    renderTournament(tid);
  }
}

function renderSB() {
  var el=document.getElementById('sb-t');
  var all=getPlayers();
  document.getElementById('sb-total').textContent=all.length+' jugadores';
  if(!ST.tournaments.length){
    el.innerHTML='<div style="padding:10px 12px;font-size:11px;opacity:.4;text-align:center">Sin torneos</div>';
    return;
  }
  el.innerHTML=ST.tournaments.map(function(t){
    return '<button class="sb-item'+(CV==='tournament'&&CT===t.id?' active':'')+'" id="snav-'+t.id+'" data-tid="'+t.id+'">'
      +'<span class="ic">🏆</span>'
      +'<div class="inf"><div class="tt">'+t.name+'</div><div class="sub">'+(t.category||'')+' '+(t.year||'')+'</div></div>'
      +'<span class="del" data-del="'+t.id+'">🗑</span>'
      +'</button>';
  }).join('');
  el.querySelectorAll('.sb-item').forEach(function(btn){
    btn.addEventListener('click', function(e){
      if(e.target.dataset.del){ e.stopPropagation(); delT(e.target.dataset.del); return; }
      go('tournament', btn.dataset.tid);
    });
  });
}

function updateFilters() {
  var all=getPlayers();
  var feds=[]; var fedsSeen={};
  all.forEach(function(p){if(p.f&&!fedsSeen[p.f]){feds.push(p.f);fedsSeen[p.f]=1;}});
  feds.sort();
  var cats=[]; var catsSeen={};
  ST.tournaments.forEach(function(t){if(t.category&&!catsSeen[t.category]){cats.push(t.category);catsSeen[t.category]=1;}});
  cats.sort();
  var fs=document.getElementById('f-fed'), pf=fs.value;
  fs.innerHTML='<option value="">🌍 Todos los países</option>'+feds.map(function(f){
    return '<option value="'+f+'"'+(f===pf||(pf===''&&f==='CRC')?' selected':'')+'>'+f+'</option>';
  }).join('');
  var cs=document.getElementById('f-cat');
  cs.innerHTML='<option value="">📚 Todas las categorías</option>'+cats.map(function(c){
    return '<option value="'+c+'">'+c+'</option>';
  }).join('');
}

