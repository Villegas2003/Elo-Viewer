<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TUNX Elo Viewer – Chess Results</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
:root{
  --bg:#f0f4f8;--card:#fff;--primary:#1a3a52;--accent:#3498db;
  --green:#27ae60;--red:#e74c3c;--gray:#64748b;--border:#e2e8f0;
  --row-hover:#f8faff;--row-open:#eff6ff;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:#1e293b;font-size:14px;min-height:100vh}

/* ── TOPBAR ── */
.topbar{background:var(--primary);color:#fff;padding:14px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;position:sticky;top:0;z-index:50;box-shadow:0 2px 8px rgba(0,0,0,.2)}
.topbar-logo{font-size:22px}
.topbar-info h1{font-size:17px;font-weight:700;line-height:1.2}
.topbar-info p{font-size:11px;opacity:.65;margin-top:2px}
.topbar-badge{margin-left:auto;background:rgba(255,255,255,.15);padding:5px 12px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}

/* ── UPLOAD ── */
.upload-wrap{padding:20px}
.upload-zone{background:var(--card);border:2px dashed var(--accent);border-radius:14px;padding:36px 20px;text-align:center;cursor:pointer;transition:all .25s}
.upload-zone:hover,.upload-zone.drag{border-color:var(--green);background:#f0fff4}
.upload-zone.loaded{border-color:var(--green);background:#f0fff4;padding:14px 20px}
.upload-zone h2{font-size:16px;color:var(--primary);margin-bottom:6px}
.upload-zone p{font-size:12px;color:var(--gray)}
.upload-icon{font-size:36px;margin-bottom:10px;display:block}
#fileInput{display:none}

/* ── CONTROLS ── */
.controls{display:flex;gap:10px;flex-wrap:wrap;padding:0 20px 16px;align-items:center}
.ctrl-group{display:flex;align-items:center;gap:6px}
.ctrl-group label{font-size:11px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
select{padding:7px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;background:#fff;cursor:pointer;outline:none;transition:border-color .2s}
select:focus{border-color:var(--accent)}

/* ── STATS ── */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;padding:0 20px 16px}
.stat{background:var(--card);border-radius:12px;padding:14px 16px;box-shadow:0 1px 3px rgba(0,0,0,.07)}
.stat-lbl{font-size:10px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
.stat-val{font-size:24px;font-weight:800;line-height:1}

/* ── CHARTS ── */
.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;padding:0 20px 16px}
.chart-card{background:var(--card);border-radius:12px;padding:18px;box-shadow:0 1px 3px rgba(0,0,0,.07)}
.chart-card h3{font-size:11px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.5px;margin-bottom:14px}
.chart-wrap{position:relative;height:230px}

/* ── TABLE ── */
.table-wrap{background:var(--card);border-radius:12px;margin:0 20px 24px;box-shadow:0 1px 3px rgba(0,0,0,.07);overflow:hidden}
.table-header{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.table-header h3{font-size:12px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:.5px}
.table-header span{font-size:11px;color:var(--gray)}
.tbl-scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:12px}
thead tr{background:#f8fafc}
th{padding:10px 12px;font-weight:700;color:var(--gray);font-size:11px;text-transform:uppercase;letter-spacing:.4px;border-bottom:2px solid var(--border);white-space:nowrap;text-align:left}
th.r{text-align:right} th.c{text-align:center}
td{padding:10px 12px;border-bottom:1px solid #f1f5f9;vertical-align:middle}
td.r{text-align:right} td.c{text-align:center}
.trow{cursor:pointer;transition:background .15s}
.trow:hover{background:var(--row-hover)}
.trow.open{background:var(--row-open)}
.games-row{display:none}
.games-row.open{display:table-row}
.games-cell{padding:0!important;border-left:3px solid var(--accent)}

/* ── BADGES ── */
.badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;white-space:nowrap}
.b-title{background:#dbeafe;color:#1e40af}
.b-fed{background:#ede9fe;color:#5b21b6}
.b-pos{background:#dcfce7;color:#166534}
.b-neg{background:#fee2e2;color:#991b1b}
.b-zero{background:#f1f5f9;color:#475569}
.pos{color:var(--green);font-weight:700}
.neg{color:var(--red);font-weight:700}
.arrow{display:inline-block;transition:transform .2s;color:var(--accent);font-size:9px;margin-right:5px}

/* ── GAMES DETAIL ── */
.games-info{background:#eff6ff;padding:10px 14px;font-size:11px;color:#1e40af;border-bottom:1px solid #bfdbfe;line-height:1.7}
.games-info code{background:#dbeafe;padding:1px 5px;border-radius:4px;font-size:10px}
.games-sum{background:#f0fdf4;padding:8px 14px;border-top:1px solid #bbf7d0;display:flex;justify-content:space-between;font-size:11px;font-weight:700}
.gtable{width:100%;border-collapse:collapse;font-size:11px}
.gtable th{background:#f8fafc;padding:7px 10px;font-size:10px;font-weight:700;color:var(--gray);text-transform:uppercase;border-bottom:1px solid var(--border);text-align:left}
.gtable th.r{text-align:right} .gtable th.c{text-align:center}
.gtable td{padding:7px 10px;border-bottom:1px solid #f1f5f9}
.gtable td.r{text-align:right} .gtable td.c{text-align:center}
.gtable tr:hover td{background:#f8faff}
.rnd{background:var(--accent);color:#fff;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:700;min-width:22px;display:inline-block;text-align:center}
.rw{background:#dcfce7;color:#166534;padding:2px 8px;border-radius:4px;font-weight:700;font-size:11px}
.rd{background:#fef9c3;color:#713f12;padding:2px 8px;border-radius:4px;font-weight:700;font-size:11px}
.rl{background:#fee2e2;color:#991b1b;padding:2px 8px;border-radius:4px;font-weight:700;font-size:11px}
.unrated{color:var(--red);font-size:9px;font-style:italic}
.color-w{color:#64748b;font-size:11px} .color-b{color:#1e293b;font-size:11px}

/* ── EMPTY ── */
.empty{text-align:center;padding:60px 20px;color:var(--gray)}
.empty h3{font-size:18px;color:var(--primary);margin-bottom:8px}
.empty p{font-size:13px}

/* ── RESPONSIVE ── */
@media(max-width:640px){
  .stats{grid-template-columns:1fr 1fr}
  th,td{padding:8px 8px;font-size:11px}
  .gtable th,.gtable td{padding:6px 7px}
  .upload-zone{padding:24px 16px}
  .controls{flex-direction:column;align-items:flex-start}
}
</style>
</head>
<body>

<div class="topbar">
  <span class="topbar-logo">♟</span>
  <div class="topbar-info">
    <h1>TUNX Elo Viewer</h1>
    <p>ΔRating = K × Σ(resultado − expected) &nbsp;|&nbsp; Fórmula FIDE oficial</p>
  </div>
  <span class="topbar-badge" id="tournamentBadge">Sin torneo cargado</span>
</div>

<div class="upload-wrap">
  <div class="upload-zone" id="uploadZone"
       onclick="document.getElementById('fileInput').click()"
       ondragover="onDrag(event,'drag')" ondragleave="onDrag(event,'')" ondrop="onDrop(event)">
    <span class="upload-icon">📂</span>
    <h2>Sube tu archivo .TUNX de Chess-Results</h2>
    <p>Arrastra aquí o haz clic para seleccionar &nbsp;•&nbsp; Los datos del XV Panamericano U17 2026 están precargados</p>
    <input type="file" id="fileInput" accept=".TUNX,.tunx,.trn" onchange="loadFile(this.files[0])">
  </div>
</div>

<div id="app" style="display:none">
  <div class="controls">
    <div class="ctrl-group">
      <label>País</label>
      <select id="fedFilter" onchange="render()"><option value="">Todos</option></select>
    </div>
    <div class="ctrl-group">
      <label>Ordenar</label>
      <select id="sortBy" onchange="render()">
        <option value="rank">Ranking inicial</option>
        <option value="change">Cambio Elo</option>
        <option value="pts">Puntos</option>
        <option value="rating">Rating</option>
      </select>
    </div>
    <div class="ctrl-group" style="margin-left:auto">
      <label>K-Factor</label>
      <select id="kOverride" onchange="render()">
        <option value="auto">Auto (FIDE)</option>
        <option value="40">40 (Juvenil)</option>
        <option value="20">20 (Estándar)</option>
        <option value="10">10 (2400+)</option>
      </select>
    </div>
  </div>

  <div class="stats" id="statsRow"></div>

  <div class="charts">
    <div class="chart-card">
      <h3>Cambio de Elo — ΔRating = K × Σ impactos</h3>
      <div class="chart-wrap"><canvas id="c1"></canvas></div>
    </div>
    <div class="chart-card">
      <h3>Rating Inicial vs Final</h3>
      <div class="chart-wrap"><canvas id="c2"></canvas></div>
    </div>
  </div>

  <div class="table-wrap">
    <div class="table-header">
      <h3 id="tableTitle">Jugadores</h3>
      <span>▶ Toca un jugador para ver sus partidas</span>
    </div>
    <div class="tbl-scroll">
      <table>
        <thead>
          <tr>
            <th style="width:28px">#</th>
            <th>Jugador</th>
            <th class="c">Fed</th>
            <th class="r">Rating</th>
            <th class="r">ΔElo</th>
            <th class="r">Rating Final</th>
            <th class="c">Pts / Rds</th>
            <th class="c">K</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<div id="emptyState" class="empty">
  <h3>Cargando datos del torneo…</h3>
  <p>Los datos del XV Panamericano U17 2026 se cargan automáticamente</p>
</div>

