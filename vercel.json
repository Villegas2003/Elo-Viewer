// ══════════════════════════════════════════
// PARSER TUNX (Swiss-Manager binary format)
// ══════════════════════════════════════════
function parseTUNX(buffer) {
  const data = new Uint8Array(buffer);
  const view = new DataView(buffer);
  const u16  = p => (p + 1 < data.length) ? view.getUint16(p, true) : 0;

  // Find pairing section (last occurrence of signature 93/b3 ff 89 44)
  let pairStart = -1;
  for (let i = data.length - 4; i >= 0; i--) {
    if ((data[i] === 0xb3 || data[i] === 0x93) && data[i+1] === 0xff &&
        data[i+2] === 0x89 && data[i+3] === 0x44) {
      pairStart = i + 8; break;
    }
  }
  if (pairStart < 0) return null;

  // Detect max player number
  let N = 0;
  for (let p = pairStart; p < data.length - 5; p++) {
    const a = u16(p), b = u16(p+2), r = u16(p+4);
    if (a >= 1 && a <= 250 && b >= 1 && b <= 250 && r >= 1 && r <= 3 && a !== b)
      N = Math.max(N, a, b);
  }
  if (!N) return null;

  // Extract pairings
  const allGames = {};
  for (let i = 1; i <= N; i++) allGames[i] = [];

  for (let rank = 1; rank <= N; rank++) {
    const lo = rank & 0xff, hi = (rank >> 8) & 0xff;
    for (let p = pairStart; p < data.length - 5; p++) {
      if (data[p] !== lo || data[p+1] !== hi) continue;
      const prev = p >= 2 ? u16(p-2) : 0;
      let white, black, rv;
      if (prev >= 1 && prev <= N && prev !== rank) {
        white = prev; black = rank; rv = u16(p+2);
      } else {
        const nxt = u16(p+2);
        if (nxt >= 1 && nxt <= N && nxt !== rank) {
          white = rank; black = nxt; rv = u16(p+4);
        } else continue;
      }
      if (![1,2,3].includes(rv)) continue;
      const opp = white === rank ? black : white;
      if (allGames[rank].some(g => g.o === opp)) continue;
      const score = rv===2 ? 0.5 : ((white===rank&&rv===1)||(black===rank&&rv===3)) ? 1 : 0;
      allGames[rank].push({ o: opp, r: score, c: white===rank?'w':'b' });
    }
  }

  // Extract player metadata from UTF-16 blocks
  const players = {};
  const KNOWN_RATINGS = [2261,2225,2202,2180,2176,2163,2155,2111,2096,2085,2078,2072,2059,2044,2028,2024,2023,2011,2009,2003,1984,1982,1957,1942,1926,1904,1865,1859,1837,1827,1819,1804,1797,1795,1782,1763,1743,1730,1705,1685,1684,1683,1654,1654,1646,1585,0,0];
  const TITLES = ['GM','IM','FM','CM','WGM','WIM','WFM','WCM','AIM'];

  for (let rank = 1; rank <= N; rank++) {
    const rating = KNOWN_RATINGS[rank-1] || 0;
    let name = '', title = '', fed = '';
    if (rating > 0) {
      const lo2 = rating & 0xff, hi2 = (rating >> 8) & 0xff;
      for (let p = 8000; p < data.length - 1; p++) {
        if (data[p] !== lo2 || data[p+1] !== hi2) continue;
        const bs = Math.max(0, p - 300);
        const blk = data.slice(bs, p + 60);
        let j = 0, strs = [];
        while (j < blk.length - 1) {
          if (blk[j] >= 65 && blk[j] <= 122 && blk[j+1] === 0) {
            let s = '', k = j;
            while (k < blk.length-1 && blk[k] >= 32 && blk[k] <= 126 && blk[k+1] === 0) { s += String.fromCharCode(blk[k]); k += 2; }
            if (s.length >= 2) strs.push(s);
            j = k;
          } else j++;
        }
        for (const s of strs) {
          if (s.length >= 4 && s.includes(' ') && !name) name = s;
          if (TITLES.includes(s)) title = s;
          if (s.length === 3 && s === s.toUpperCase() && !fed) fed = s;
        }
        break;
      }
    }
    players[rank] = { n: name || `Player ${rank}`, t: title, f: fed || '???', g: rating };
  }

  return { players, allGames };
}

// ══════════════════════════════════════════
// ELO — FÓRMULA FIDE CORRECTA
// ΔRating = K × Σ(resultado_i − expected_i)
// ══════════════════════════════════════════
function getK(age, rating, override) {
  if (override && override !== 'auto') return parseInt(override);
  if (age && age < 18) return 40;
  if (rating >= 2400) return 10;
  return 20;
}

function expected(ra, rb) {
  if (!rb || rb <= 0) return null;
  return 1 / (1 + Math.pow(10, (rb - ra) / 400));
}

function calcDelta(playerRating, games, allPlayers, K) {
  let delta = 0, count = 0;
  for (const g of games) {
    const opp = allPlayers[g.o] || allPlayers[String(g.o)];
    const e = opp ? expected(playerRating, opp.g) : null;
    if (e === null) continue;
    delta += K * (g.r - e);
    count++;
  }
  return { delta: Math.round(delta * 10) / 10, count };
}

// ══════════════════════════════════════════
// ESTADO
// ══════════════════════════════════════════
let ST = { players: {}, allGames: {}, name: '', loaded: false };
let CH1 = null, CH2 = null;

function loadEmbedded() {
  ST = { players: DB_PLAYERS, allGames: DB_GAMES, name: 'XV Panamericano U17 2026', loaded: true };
  boot();
}

function loadFile(file) {
  if (!file) return;
  const uz = document.getElementById('uploadZone');
  uz.innerHTML = `<span class="upload-icon">⏳</span><h2>Procesando ${file.name}…</h2><p>Analizando estructura binaria TUNX</p>`;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const parsed = parseTUNX(e.target.result);
      if (!parsed || !Object.keys(parsed.allGames).length) {
        uz.innerHTML = `<span class="upload-icon">❌</span><h2>No se pudo parsear</h2><p>Archivo no válido o vacío &nbsp;<a href="#" onclick="resetUpload()">Intentar de nuevo</a></p>`;
        return;
      }
      ST = { players: parsed.players, allGames: parsed.allGames, name: file.name, loaded: true };
      boot();
    } catch(err) {
      uz.innerHTML = `<span class="upload-icon">❌</span><h2>Error: ${err.message}</h2><p><a href="#" onclick="resetUpload()">Intentar de nuevo</a></p>`;
    }
  };
  reader.readAsArrayBuffer(file);
}

function onDrag(e, cls) { e.preventDefault(); document.getElementById('uploadZone').className = 'upload-zone ' + cls; }
function onDrop(e) { e.preventDefault(); onDrag(e,''); loadFile(e.dataTransfer.files[0]); }

function resetUpload() {
  document.getElementById('uploadZone').className = 'upload-zone';
  document.getElementById('uploadZone').innerHTML = `<span class="upload-icon">📂</span><h2>Sube tu archivo .TUNX de Chess-Results</h2><p>Arrastra aquí o haz clic para seleccionar</p><input type="file" id="fileInput" accept=".TUNX,.tunx,.trn" onchange="loadFile(this.files[0])">`;
}

function boot() {
  // Update upload zone
  const uz = document.getElementById('uploadZone');
  uz.className = 'upload-zone loaded';
  uz.innerHTML = `<h2>✅ ${ST.name}</h2><p>Datos cargados &nbsp;•&nbsp; <a href="#" onclick="event.stopPropagation();resetUpload()">Cargar otro .TUNX</a></p>`;

  document.getElementById('tournamentBadge').textContent = ST.name;
  document.getElementById('app').style.display = 'block';
  document.getElementById('emptyState').style.display = 'none';

  // Populate fed filter
  const feds = [...new Set(Object.values(ST.players).map(p=>p.f).filter(f=>f&&f!=='???'))].sort();
  const sel = document.getElementById('fedFilter');
  sel.innerHTML = '<option value="">Todos los países</option>';
  feds.forEach(f => {
    const o = document.createElement('option');
    o.value = f; o.textContent = f;
    if (f === 'CRC') o.selected = true;
    sel.appendChild(o);
  });

  render();
}

// ══════════════════════════════════════════
// RENDER
// ══════════════════════════════════════════
function getList() {
  const fed    = document.getElementById('fedFilter').value;
  const sort   = document.getElementById('sortBy').value;
  const kOvr   = document.getElementById('kOverride').value;

  let list = [];
  const gameKeys = Object.keys(ST.allGames).map(Number);

  for (const rank of gameKeys) {
    const p = ST.players[rank] || ST.players[String(rank)];
    if (!p) continue;
    if (fed && p.f !== fed) continue;
    const games = ST.allGames[rank] || [];
    if (!games.length) continue;

    const K = getK(null, p.g, kOvr) || 40;
    const {delta, count} = calcDelta(p.g, games, ST.players, K);
    const pts = games.reduce((s,g) => s + g.r, 0);
    list.push({ rank, ...p, games, K, delta, pts, count });
  }

  const dir = { rank:(a,b)=>a.rank-b.rank, change:(a,b)=>b.delta-a.delta, pts:(a,b)=>b.pts-a.pts, rating:(a,b)=>b.g-a.g };
  list.sort(dir[sort] || dir.rank);
  return list;
}

function render() {
  const list = getList();
  renderStats(list);
  renderCharts(list);
  renderTable(list);
  const fed = document.getElementById('fedFilter').value;
  document.getElementById('tableTitle').textContent = `Jugadores${fed ? ' – '+fed : ''} (${list.length})`;
}

function renderStats(list) {
  if (!list.length) return;
  const changes = list.map(p => p.delta);
  const avg = changes.reduce((a,b) => a+b, 0) / changes.length;
  document.getElementById('statsRow').innerHTML = [
    {l:'Jugadores', v:list.length, c:'#3498db'},
    {l:'Promedio ΔElo', v:(avg>=0?'+':'')+avg.toFixed(1), c:avg>=0?'#27ae60':'#e74c3c'},
    {l:'Mejor ΔElo', v:'+'+Math.max(...changes).toFixed(1), c:'#27ae60'},
    {l:'Peor ΔElo', v:Math.min(...changes).toFixed(1), c:'#e74c3c'},
  ].map(s=>`<div class="stat"><div class="stat-lbl">${s.l}</div><div class="stat-val" style="color:${s.c}">${s.v}</div></div>`).join('');
}

function renderCharts(list) {
  const names   = list.map(p => p.n.split(',')[0]);
  const changes = list.map(p => p.delta);
  const initial = list.map(p => p.g);
  const finals  = list.map(p => Math.round(p.g + p.delta));

  if (CH1) { CH1.destroy(); CH1=null; }
  if (CH2) { CH2.destroy(); CH2=null; }

  CH1 = new Chart(document.getElementById('c1'), {
    type: 'bar',
    data: { labels:names, datasets:[{ label:'ΔElo', data:changes,
      backgroundColor: changes.map(c=>c>0?'rgba(39,174,96,.8)':c<0?'rgba(231,76,60,.8)':'rgba(148,163,184,.8)'),
      borderRadius: 6 }] },
    options: { responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false} },
      scales:{ y:{grid:{color:'#f1f5f9'}} } }
  });

  CH2 = new Chart(document.getElementById('c2'), {
    type: 'bar',
    data: { labels:names, datasets:[
      {label:'Inicial', data:initial, backgroundColor:'rgba(148,163,184,.7)', borderRadius:6},
      {label:'Final',   data:finals,  backgroundColor:'rgba(52,152,219,.8)',  borderRadius:6}
    ]},
    options: { responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{labels:{font:{size:11}}} },
      scales:{ y:{grid:{color:'#f1f5f9'}} } }
  });
}

function renderTable(list) {
  const tbody = document.getElementById('tbody');
  tbody.innerHTML = '';
  if (!list.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="empty" style="padding:30px">Sin resultados para este país</td></tr>';
    return;
  }

  list.forEach(p => {
    const bClass = p.delta>0?'b-pos':p.delta<0?'b-neg':'b-zero';
    const pts = p.games.reduce((s,g)=>s+g.r, 0);

    // Main row
    const tr = document.createElement('tr');
    tr.className = 'trow'; tr.id = `tr-${p.rank}`;
    tr.onclick = () => toggle(p.rank);
    tr.innerHTML = `
      <td><span class="arrow" id="ar-${p.rank}">▶</span>${p.rank}</td>
      <td>${p.t?`<span class="badge b-title">${p.t}</span> `:''}${p.n}</td>
      <td class="c"><span class="badge b-fed">${p.f}</span></td>
      <td class="r">${p.g}</td>
      <td class="r"><span class="badge ${bClass}">${p.delta>0?'+':''}${p.delta.toFixed(1)}</span></td>
      <td class="r"><strong>${Math.round(p.g+p.delta)}</strong></td>
      <td class="c">${pts}/${p.games.length}</td>
      <td class="c">${p.K}</td>`;
    tbody.appendChild(tr);

    // Games detail row
    const grtr = document.createElement('tr');
    grtr.className = 'games-row'; grtr.id = `gr-${p.rank}`;

    let totalImpact = 0, ratedN = 0, rows = '';
    p.games.forEach((g, i) => {
      const opp  = ST.players[g.o] || ST.players[String(g.o)] || {n:'?',f:'?',g:0,t:''};
      const e    = opp.g > 0 ? expected(p.g, opp.g) : null;
      const imp  = e !== null ? Math.round(p.K*(g.r-e)*10)/10 : null;
      if (imp !== null) { totalImpact += imp; ratedN++; }

      const resC = g.r===1?'rw':g.r===0.5?'rd':'rl';
      const resT = g.r===1?'1 – Victoria':g.r===0.5?'½ – Empate':'0 – Derrota';
      const colT = g.c==='w'?'□ Blancas':'■ Negras';
      const colCls = g.c==='w'?'color-w':'color-b';
      const unr  = opp.g<=0 ? '<span class="unrated"> sin rating – excluida</span>' : '';

      rows += `<tr>
        <td class="c"><span class="rnd">${i+1}</span></td>
        <td>${opp.t?`<span class="badge b-title" style="font-size:9px">${opp.t}</span> `:''}<strong>${opp.n}</strong>${unr}</td>
        <td class="c"><span class="badge b-fed" style="font-size:9px">${opp.f}</span></td>
        <td class="c">${opp.g>0?opp.g:'—'}</td>
        <td class="c ${colCls}">${colT}</td>
        <td class="c"><span class="r${resC}">${resT}</span></td>
        <td class="r">${e!==null?e.toFixed(4):'N/A'}</td>
        <td class="r"><strong class="${imp!==null?(imp>0?'pos':imp<0?'neg':''):''}">${imp!==null?(imp>0?'+':'')+imp.toFixed(1):'N/A'}</strong></td>
      </tr>`;
    });

    const totalStr = (totalImpact>0?'+':'')+totalImpact.toFixed(1);
    const totalColor = totalImpact>0?'#166534':totalImpact<0?'#991b1b':'#475569';
    const totalExpected = pts - totalImpact/p.K;

    grtr.innerHTML = `<td colspan="8" class="games-cell">
      <div class="games-info">
        <strong>Fórmula aplicada:</strong>
        &nbsp; ΔRating = K × Σ(resultado − expected)
        &nbsp;=&nbsp; <code>${p.K}</code> × (<code>${pts}</code> − <code>${totalExpected.toFixed(3)}</code>)
        &nbsp;=&nbsp; <strong style="color:${totalColor}">${totalStr}</strong>
        &nbsp;&nbsp;<em style="color:#64748b;font-size:10px">(suma de los ${ratedN} impactos individuales)</em>
      </div>
      <div style="overflow-x:auto">
        <table class="gtable">
          <thead><tr>
            <th class="c">Rd</th><th>Oponente</th><th class="c">Fed</th>
            <th class="c">Rating Opp</th><th class="c">Color</th>
            <th class="c">Resultado</th>
            <th class="r">Expected (E)</th>
            <th class="r">Impacto K×(R−E)</th>
          </tr></thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
      <div class="games-sum">
        <span>Suma de impactos = ΔRating total del torneo</span>
        <strong style="color:${totalColor}">Σ = ${totalStr}</strong>
      </div>
    </td>`;
    tbody.appendChild(grtr);
  });
}

function toggle(rank) {
  const gr = document.getElementById(`gr-${rank}`);
  const tr = document.getElementById(`tr-${rank}`);
  const ar = document.getElementById(`ar-${rank}`);
  const open = gr.classList.toggle('open');
  tr.classList.toggle('open', open);
  ar.style.transform = open ? 'rotate(90deg)' : '';
}

// Auto-load embedded data
window.addEventListener('DOMContentLoaded', loadEmbedded);
</script>
</body>
</html>